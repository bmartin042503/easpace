<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="easpace.Desktop.App"
             xmlns:dataTemplates="clr-namespace:easpace.Desktop.DataTemplates"
             RequestedThemeVariant="Default">

    <!-- Global resources -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="/Styles/Themes/LightTheme.axaml" />
                <MergeResourceInclude Source="/Styles/Themes/DarkTheme.axaml" />
                <MergeResourceInclude Source="/Styles/Icons.axaml" />
                <MergeResourceInclude Source="/Styles/Tokens/Thickness.axaml" />
                <MergeResourceInclude Source="/Styles/Tokens/CornerRadius.axaml" />
                <MergeResourceInclude Source="/Styles/Tokens/Size.axaml" />
                <MergeResourceInclude Source="/Styles/Tokens/FontSize.axaml" />
                <MergeResourceInclude Source="/Styles/ActivityTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <FontFamily x:Key="Poppins">avares://easpace.Desktop/Assets/Fonts#Poppins</FontFamily>
    </Application.Resources>

    <Application.DataTemplates>
        <dataTemplates:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>

        <!-- AXAML styling -->
        <StyleInclude Source="Styles/TextBlock.axaml" />
        <StyleInclude Source="Styles/TextBox.axaml" />
        <StyleInclude Source="Styles/Button.axaml" />
        <StyleInclude Source="Styles/ToggleButton.axaml" />
        <StyleInclude Source="Styles/Border.axaml" />
        <StyleInclude Source="Styles/ListBox.axaml" />
        <StyleInclude Source="Styles/Path.axaml" />
        <StyleInclude Source="Styles/GridSplitter.axaml" />
        <StyleInclude Source="Styles/MoodEntryFlyout.axaml" />
        <StyleInclude Source="Styles/Slider.axaml" />
        <StyleInclude Source="Styles/TrendChart.axaml" />

        <!-- Templated controls -->
        <StyleInclude Source="Controls/JournalEntry.axaml" />
        <StyleInclude Source="Controls/MoodEntry.axaml" />

        <FluentTheme />
    </Application.Styles>
</Application>