<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="easpace.Desktop.App"
             xmlns:dataTemplates="clr-namespace:easpace.Desktop.DataTemplates"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <dataTemplates:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>

        <!-- Avalonia Fluent Theme -->
        <FluentTheme />
        
        <!-- Haven Theme -->
        <StyleInclude Source="Resources/HavenTheme/HavenTheme.axaml" />
        
    </Application.Styles>
</Application>