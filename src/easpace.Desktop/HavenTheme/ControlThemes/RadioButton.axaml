<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">

    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource Haven.Sem.Canvas}">
            <StackPanel Spacing="10">
                <RadioButton Content="Option 1" />
                <RadioButton IsChecked="True" Content="Option 2" />
                <RadioButton IsEnabled="False" Content="Option 3" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>


    <x:Double x:Key="RadioButtonMinHeight">32</x:Double>

    <ControlTheme x:Key="{x:Type RadioButton}"
                  TargetType="RadioButton">

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{DynamicResource RadioButtonMinHeight}" />
        <Setter Property="FontFamily" Value="{StaticResource Haven.FontFamily.Poppins}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="Background" Value="{StaticResource Haven.Scale.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Border}" />

        <!-- Template -->
        <Setter Property="Template">
            <ControlTemplate TargetType="RadioButton">

                <Grid ColumnDefinitions="20,*"
                      ColumnSpacing="{StaticResource Haven.Scale.Spacing.Xxs}">

                    <!-- Radio indicator -->
                    <Grid Grid.Column="0"
                          Height="{DynamicResource RadioButtonMinHeight}"
                          VerticalAlignment="Top">

                        <!-- Outer circle -->
                        <Ellipse x:Name="OuterEllipse"
                                 Width="20"
                                 Height="20"
                                 Fill="{DynamicResource Haven.Sem.Surface.Elevated}"
                                 Stroke="{DynamicResource Haven.Sem.Foreground.Subtle}"
                                 StrokeThickness="{StaticResource Haven.Scale.Border.Thickness.Double.Medium}"
                                 UseLayoutRounding="False" />

                        <!-- Selected dot -->
                        <Ellipse x:Name="CheckGlyph" Width="8" Height="8" Opacity="0"
                                 Fill="{DynamicResource Haven.Sem.Accent}"
                                 UseLayoutRounding="False" />

                    </Grid>


                    <!-- Content -->
                    <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                      FontFamily="{TemplateBinding FontFamily}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextWrapping="Wrap" RecognizesAccessKey="True" />

                </Grid>

            </ControlTemplate>
        </Setter>


        <!-- Checked -->
        <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource Haven.Sem.Accent}" />
        </Style>

        <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource Haven.Sem.Accent}" />
            <Setter Property="Opacity" Value="1" />
        </Style>


        <!-- Checked + PointerOver / Pressed -->
        <Style
            Selector="^:checked:pointerover /template/ Ellipse#OuterEllipse,
                      ^:checked:pressed /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource Haven.Sem.Accent.Hover}" />
        </Style>

        <Style
            Selector="^:checked:pointerover /template/ Ellipse#CheckGlyph,
                      ^:checked:pressed /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource Haven.Sem.Accent.Hover}" />
        </Style>


        <!-- Disabled -->
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground.Subtle}" />
        </Style>

        <Style Selector="^:disabled /template/ Ellipse#OuterEllipse">
            <Setter Property="Stroke" Value="{DynamicResource Haven.Sem.Foreground.Muted}" />
        </Style>

        <Style Selector="^:disabled /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource Haven.Sem.Foreground.Subtle}" />
        </Style>

    </ControlTheme>

</ResourceDictionary>