<!--
HavenTheme is a custom design system based on Avalonia's FluentTheme, using Phosphor Icons for iconography. 
It follows a three-tier token architecture: Scale tokens define raw UI values, while Semantic tokens map them to context-aware roles for Light and Dark modes. 
Component files located in the `Styles` directory apply these tokens to style individual controls.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:easpace.Desktop.Converters">

    <Styles.Resources>
        <ResourceDictionary>

            <!-- Merged Dictionaries -->
            <ResourceDictionary.MergedDictionaries>

                <!-- Scales -->
                <ResourceInclude Source="Scales/Colors.axaml" />
                <ResourceInclude Source="Scales/Border.axaml" />
                <ResourceInclude Source="Scales/Radius.axaml" />
                <ResourceInclude Source="Scales/Spacing.axaml" />
                <ResourceInclude Source="Scales/Typography.axaml" />
                <ResourceInclude Source="Scales/Sizes.axaml" />

                <!-- Icons -->
                <ResourceInclude Source="Icons/AppIcons.axaml" />
                <ResourceInclude Source="Icons/PhosphorIcons.axaml" />

                <!-- FluentTheme overriden control themes -->
                <ResourceInclude Source="Overrides/WindowDrawnDecorations.axaml" />
                <ResourceInclude Source="Overrides/DataValidationErrors.axaml" />
                <ResourceInclude Source="Overrides/CheckBox.axaml" />
                <ResourceInclude Source="Overrides/ButtonSpinner.axaml" />
                <ResourceInclude Source="Overrides/NumericUpDown.axaml" />
                <ResourceInclude Source="Overrides/RadioButton.axaml" />
                <ResourceInclude Source="Overrides/Slider.axaml" />
                <ResourceInclude Source="Overrides/Calendar.axaml" />
                <ResourceInclude Source="Overrides/CalendarButton.axaml" />
                <ResourceInclude Source="Overrides/CalendarDatePicker.axaml" />
                <ResourceInclude Source="Overrides/CalendarDayButton.axaml" />
                <ResourceInclude Source="Overrides/CalendarItem.axaml" />
                <ResourceInclude Source="Overrides/TimePicker.axaml" />
                
                <!-- Custom control themes -->
                <ResourceInclude Source="Controls/IconListItem.axaml" />
                <ResourceInclude Source="Controls/NavigationListItem.axaml" />
                <ResourceInclude Source="Controls/ActivityListItem.axaml" />
                <ResourceInclude Source="Controls/DataEntryListItem.axaml" />
                
            </ResourceDictionary.MergedDictionaries>

            <!-- Color schemes -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="ColorSchemes/Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="ColorSchemes/Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>

        <!-- Poppins font -->
        <FontFamily x:Key="Haven.FontFamily.Poppins">avares://easpace.Desktop/Assets/Fonts#Poppins</FontFamily>

        <!-- Converters -->
        <converters:RelativeDateConverter x:Key="RelativeDateConverter" />
        <converters:EnumToLocalizedConverter x:Key="EnumToLocalizedConverter" />
        <converters:TimeRangeConverter x:Key="TimeRangeConverter" />
        <converters:ValidationResultToLocalizedConverter x:Key="ValidationResultToLocalizedConverter" />
        <converters:MoodSliderValueConverter x:Key="MoodSliderValueConverter" />

    </Styles.Resources>

    <!-- Styles -->
    <StyleInclude Source="Styles/Border.axaml" />
    <StyleInclude Source="Styles/Button.axaml" />
    <StyleInclude Source="Styles/GridSplitter.axaml" />
    <StyleInclude Source="Styles/ListBox.axaml" />
    <StyleInclude Source="Styles/ListBoxItem.axaml" />
    <StyleInclude Source="Styles/Path.axaml" />
    <StyleInclude Source="Styles/TextBlock.axaml" />
    <StyleInclude Source="Styles/TextBox.axaml" />
    <StyleInclude Source="Styles/ComboBox.axaml" />
    <StyleInclude Source="Styles/ToggleButton.axaml" />
    <StyleInclude Source="Styles/ToggleSwitch.axaml" />
    <StyleInclude Source="Styles/PathIcon.axaml" />
    <StyleInclude Source="Styles/TrendChart.axaml" />
    <StyleInclude Source="Styles/MilestoneChart.axaml" />
    <StyleInclude Source="Styles/RoutineMonthItem.axaml" />

</Styles>