<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <!-- To change between Dark/Light mode in the Preview, change the RequestedThemeVariant value -->
        <ThemeVariantScope RequestedThemeVariant="Light">
            <Border Padding="20" Background="{DynamicResource Neutral100}">

                <StackPanel Orientation="Vertical" Spacing="20">

                    <Button Classes="primary icon">
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.Plus.Bold}" />
                    </Button>
                    
                    <Button Classes="secondary icon">
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.Pencil.Fill}" />
                    </Button>
                    
                    <Button Classes="tertiary icon">
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.Pencil.Fill}" />
                    </Button>
                    
                    <Button Classes="tertiary danger icon">
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.Trash.Fill}" />
                    </Button>
                    
                    <Button Classes="tertiary icon" IsEnabled="False">
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.Trash.Fill}" />
                    </Button>
                    
                    <Button Classes="primary icon" IsEnabled="False">
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.Plus.Bold}" />
                    </Button>
                    
                    <Button Classes="secondary icon" IsEnabled="False">
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.Pencil.Fill}" />
                    </Button>
                    
                    <Button Classes="secondary regular" Content="Secondary Regular" />
                    <Button Classes="primary regular" Content="Primary Regular" />
                    <Button Classes="danger regular" Content="Danger Regular" />

                </StackPanel>
            </Border>
        </ThemeVariantScope>
    </Design.PreviewWith>

    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Haven.FontFamily.Poppins}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Sm}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Gradient.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Accent.Strong} " />
        <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.OnAccent}" />

        <Style Selector="^:pointerover /template/ ContentPresenter, ^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Gradient.Accent.Hover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Accent.Strong} " />
            <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.OnAccent}" />
        </Style>
    </Style>
    
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Accent.Muted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Accent.Strong} " />
        <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent.Strong}" />

        <Style Selector="^:pointerover /template/ ContentPresenter, ^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Accent.Muted.Hover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Accent.Strong} " />
            <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent.Strong}" />
        </Style>
    </Style>
    
    <Style Selector="Button.tertiary">
        <Setter Property="Background" Value="{StaticResource Haven.Scale.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent.Strong}" />
        <Setter Property="BorderThickness" Value="0" />

        <Style Selector="^:pointerover /template/ ContentPresenter, ^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Haven.Scale.Transparent}" />
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        
        <Style Selector="^:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Haven.Scale.Transparent}" />
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground.Subtle}" />
        </Style>
    </Style>
    
    <Style Selector="Button.regular.danger">
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Gradient.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Danger.Strong} " />
        <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.OnDanger}" />

        <Style Selector="^:pointerover /template/ ContentPresenter, ^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Gradient.Danger.Hover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Danger.Strong} " />
            <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.OnDanger}" />
        </Style>
    </Style>
    
    <Style Selector="Button.tertiary.danger">
        <Style Selector="^:pointerover /template/ ContentPresenter, ^:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Danger}" />
        </Style>
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="CornerRadius" Value="{StaticResource Haven.Scale.Radius.Circular}" />
        <Setter Property="Padding" Value="{StaticResource Haven.Scale.Spacing.Thickness.Xxs}" />
        
        <Style Selector="^ PathIcon">
            <Setter Property="Width" Value="{StaticResource Haven.Scale.Icon.Size.Xs}" />
            <Setter Property="Height" Value="{StaticResource Haven.Scale.Icon.Size.Xs}" />
        </Style>
    </Style>
    
    <Style Selector="Button.regular">
        <Setter Property="CornerRadius" Value="{StaticResource Haven.Scale.Radius.Xs}" />
        <Setter Property="Padding" Value="{StaticResource Haven.Scale.Spacing.Thickness.Wide.Xxs}" />
    </Style>
    
    <Style Selector="Button.clear">
        <Setter Property="Background" Value="{StaticResource Haven.Scale.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="BorderThickness" Value="0" />

        <Style Selector="^:pointerover /template/ ContentPresenter, ^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Haven.Scale.Transparent}" />
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Style>

</Styles>