<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource Haven.Sem.Canvas}">
            <Border Classes="card secondary" Padding="20">
                <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12" MaxWidth="200">

                    <ToggleButton IsChecked="False"
                                  Classes="mood-label">
                        <TextBlock Text="Happiness" />
                    </ToggleButton>

                    <ToggleButton IsChecked="False"
                                  Classes="mood-label">
                        <TextBlock Text="Hope" />
                    </ToggleButton>

                    <ToggleButton IsChecked="True"
                                  Classes="mood-label">
                        <TextBlock Text="Calm" />
                    </ToggleButton>

                </WrapPanel>
            </Border>
        </Border>
    </Design.PreviewWith>

    <!-- Mood label toggle button styling -->
    <Style Selector="ToggleButton.mood-label">
        <Setter Property="Padding" Value="{StaticResource Haven.Scale.Spacing.Thickness.Wide.Xxs}" />
        <Setter Property="CornerRadius" Value="{StaticResource Haven.Scale.Radius.Xs}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Xs}" />

        <Style
            Selector="^ /template/ ContentPresenter,
                      ^:pointerover /template/ ContentPresenter,
                      ^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Surface.Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="^:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Surface.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent.Strong}" />
        </Style>
        
        <Setter Property="RenderTransform">
            <TranslateTransform />
        </Setter>
        
        <Style.Animations>
            <Animation Duration="0:0:0.45" Easing="CubicEaseOut" FillMode="Forward">
                
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="-20" />
                </KeyFrame>
                
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
                
            </Animation>
        </Style.Animations>

    </Style>
    
</Styles>