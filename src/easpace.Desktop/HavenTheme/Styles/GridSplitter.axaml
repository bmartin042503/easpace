<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <!-- To change between Dark/Light mode in the Preview, change the RequestedThemeVariant value -->
        <ThemeVariantScope RequestedThemeVariant="Light">
            <Border Padding="20" Background="{DynamicResource Neutral100}">

                <Grid ColumnDefinitions="*,Auto,*" Height="300">
                    <GridSplitter Grid.Column="1" Classes="vertical" />
                </Grid>

            </Border>
        </ThemeVariantScope>

    </Design.PreviewWith>

    <!-- GridSplitter template & styling -->
    <Style Selector="GridSplitter.vertical">

        <Setter Property="Width" Value="{StaticResource Haven.Scale.Spacing.Xs}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{StaticResource Haven.Scale.Transparent}">
                    <Rectangle Fill="{DynamicResource Haven.Sem.Border}"
                               Width="{StaticResource Haven.Scale.Border.Thickness.Double}" />
                </Border>
            </ControlTemplate>
        </Setter>

    </Style>
</Styles>