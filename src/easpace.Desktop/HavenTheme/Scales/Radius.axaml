    <CornerRadius x:Key="Haven.Scale.Radius.Xs">6</CornerRadius>
    <CornerRadius x:Key="Haven.Scale.Radius.Sm">8</CornerRadius>
    <CornerRadius x:Key="Haven.Scale.Radius.Md">10</CornerRadius>
    <CornerRadius x:Key="Haven.Scale.Radius.Lg">12</CornerRadius>
    <CornerRadius x:Key="Haven.Scale.Radius.Xl">14</CornerRadius>
