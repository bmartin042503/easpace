<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:templatedControls="clr-namespace:easpace.Desktop.Resources.HavenTheme.TemplatedControls">

    <Style Selector="templatedControls|ActivityListItem">

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Container.Name="list-item" Container.Sizing="Width">
                    
                    <Border.Styles>
                        <ContainerQuery Name="list-item" Query="max-width:250">
                            <Style Selector="TextBlock#PART_Status">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                        </ContainerQuery>
                    </Border.Styles>
                    
                    <Border.Styles>
                        <ContainerQuery Query="max-width:200">
                            <Style Selector="TextBlock#PART_Status">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                        </ContainerQuery>
                    </Border.Styles>
                    
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="{StaticResource Haven.Scale.Spacing.Sm}">

                        <TextBlock Name="PART_Title" Grid.Column="0"
                                   Text="{TemplateBinding Title}"
                                   VerticalAlignment="Center" Classes="fs6 trm-ellipsis" />

                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                              ColumnSpacing="{StaticResource Haven.Scale.Spacing.Xs}">

                            <TextBlock Name="PART_Status" Grid.Column="0"
                                       VerticalAlignment="Center" Classes="fs6 trm-ellipsis"
                                       Text="{TemplateBinding Status}" />

                            <PathIcon Name="PART_Icon" Grid.Column="1"
                                      Data="{TemplateBinding Icon}" />
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        
    </Style>

</Styles>