<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:templatedControls="clr-namespace:easpace.Desktop.HavenTheme.TemplatedControls">

    <Style Selector="templatedControls|NavigationListItem">
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Haven.Scale.Spacing.Xs}">
                        <PathIcon Name="PART_Icon"
                                  Data="{TemplateBinding Icon}"
                                  Foreground="{TemplateBinding Foreground}" />

                        <TextBlock Name="PART_Text"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding Text}"
                                   Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>

                </Border>
            </ControlTemplate>
        </Setter>
        
    </Style>

</Styles>