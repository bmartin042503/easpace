<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:easpace.Desktop.HavenTheme.Controls">

    <ControlTheme x:Key="{x:Type controls:ActivityListItem}" TargetType="controls:ActivityListItem">

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Container.Name="list-item" Container.Sizing="Width"
                        ToolTip.Tip="{TemplateBinding Name}">

                    <Border.Styles>

                        <ContainerQuery Name="list-item" Query="max-width:180">
                            <Style Selector="TextBlock#PART_Value">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                        </ContainerQuery>
                        
                        <ContainerQuery Name="list-item" Query="max-width:250">
                            <Style Selector="TextBlock#PART_Unit">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                        </ContainerQuery>

                    </Border.Styles>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="{StaticResource Haven.Scale.Spacing.Sm}">

                        <TextBlock Name="PART_Title" Grid.Column="0"
                                   Text="{TemplateBinding Title}"
                                   VerticalAlignment="Center" Classes="fs6 trm-ellipsis" />

                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                              ColumnSpacing="{StaticResource Haven.Scale.Spacing.Xs}">

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                
                                <TextBlock Name="PART_Value" VerticalAlignment="Center" Classes="fs6 trm-ellipsis"
                                           Text="{TemplateBinding Value}" />

                                <TextBlock Name="PART_Unit" VerticalAlignment="Center" Classes="fs6 trm-ellipsis"
                                           Text="{TemplateBinding Unit}"
                                           IsVisible="{TemplateBinding ShowUnit}" />
                                
                            </StackPanel>

                            <PathIcon Name="PART_Icon" Grid.Column="1"
                                      Data="{TemplateBinding Icon}" />
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

    </ControlTheme>

</ResourceDictionary>