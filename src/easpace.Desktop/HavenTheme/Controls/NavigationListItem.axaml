<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:easpace.Desktop.HavenTheme.Controls">

    <ControlTheme x:Key="{x:Type controls:NavigationListItem}" TargetType="controls:NavigationListItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Haven.Scale.Spacing.Xs}">
                        <PathIcon Name="PART_Icon"
                                  Data="{TemplateBinding Icon}"
                                  Foreground="{TemplateBinding Foreground}" />

                        <TextBlock Name="PART_Text"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding Text}"
                                   Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>

                </Border>
            </ControlTemplate>
        </Setter>
        
    </ControlTheme>

</ResourceDictionary>