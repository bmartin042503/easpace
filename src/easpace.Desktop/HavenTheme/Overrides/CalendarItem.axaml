<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme x:Key="Haven.Calendar.HeaderButton" TargetType="Button">

        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Haven.Scale.Radius.Xs}" />
        <Setter Property="Padding" Value="{StaticResource Haven.Scale.Spacing.Thickness.Horizontal.Xs}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Sm}" />
        <Setter Property="FontWeight" Value="{StaticResource Haven.Scale.FontWeight.Medium}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Surface.Accent}" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent.Strong}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Accent.Muted.Hover}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent.Strong}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground.Muted}" />
        </Style>

    </ControlTheme>

    <ControlTheme x:Key="Haven.Calendar.NavigationButton" TargetType="Button">

        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="{StaticResource Haven.Scale.Spacing.Thickness.Md}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground.Subtle}" />
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Haven.Scale.Radius.Xs}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Surface.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Border.Accent}" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent.Strong}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Accent.Muted.Hover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Accent}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent.Strong}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground.Muted}" />
        </Style>

    </ControlTheme>

    <ControlTheme x:Key="{x:Type CalendarItem}" TargetType="CalendarItem">

        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Haven.Scale.Radius.Md}" />

        <Setter Property="DayTitleTemplate">
            <Template x:DataType="x:String">
                <TextBlock Text="{Binding}"
                           Foreground="{DynamicResource Haven.Sem.Foreground.Subtle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Haven.Scale.FontSize.Xs}"
                           FontWeight="{StaticResource Haven.Scale.FontWeight.Medium}" />
            </Template>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Grid MinWidth="308" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          ColumnDefinitions="Auto,*" RowDefinitions="44,*" Grid.IsSharedSizeScope="True">

                        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto"
                              Background="{TemplateBinding HeaderBackground}">
                            <Button Name="PART_HeaderButton" Theme="{StaticResource Haven.Calendar.HeaderButton}"
                                    Margin="4,4,2,4" />

                            <Button Name="PART_PreviousButton" Grid.Column="1"
                                    Theme="{StaticResource Haven.Calendar.NavigationButton}">
                                <PathIcon Width="{StaticResource Haven.Scale.Icon.Size.Xxs}"
                                          Height="{StaticResource Haven.Scale.Icon.Size.Xxs}"
                                          Data="{StaticResource Haven.PhosphorIcons.CaretUp.Bold}" />
                            </Button>

                            <Button Name="PART_NextButton" Grid.Column="2"
                                    Theme="{StaticResource Haven.Calendar.NavigationButton}" Margin="2,2,4,2">
                                <PathIcon Width="{StaticResource Haven.Scale.Icon.Size.Xxs}"
                                          Height="{StaticResource Haven.Scale.Icon.Size.Xxs}"
                                          Data="{StaticResource Haven.PhosphorIcons.CaretDown.Bold}" />
                            </Button>
                        </Grid>

                        <Border Name="BackgroundLayer" Grid.Row="1" Grid.Column="1"
                                Margin="0,38,0,0" Background="{DynamicResource Haven.Sem.Surface.Elevated}"
                                IsVisible="{Binding #PART_MonthView.IsVisible}" />

                        <Grid Name="PART_ElementWeekNumberLabels" Grid.Row="1" Grid.Column="0"
                              MinWidth="38" Background="{DynamicResource Haven.Sem.Surface}" IsVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                            </Grid.RowDefinitions>
                            <ContentControl Name="WeekNumberHeader" Grid.Row="0"
                                            Content="{StaticResource StringCalendarWeekNumberHeader}"
                                            Foreground="{DynamicResource Haven.Sem.Foreground.Subtle}"
                                            FontSize="{StaticResource Haven.Scale.FontSize.Xs}"
                                            FontWeight="{StaticResource Haven.Scale.FontWeight.Medium}"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center" />
                        </Grid>

                        <Grid Name="PART_MonthView" Grid.Row="1" Grid.Column="1" MinHeight="288"
                              Background="{DynamicResource Haven.Sem.Surface.Elevated}" IsVisible="False"
                              ColumnDefinitions="*,*,*,*,*,*,*">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                                <RowDefinition Height="Auto" SharedSizeGroup="HavenCalendarMonthViewWeekRow" />
                            </Grid.RowDefinitions>
                        </Grid>

                        <Grid Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="2" MinHeight="288"
                              Background="{DynamicResource Haven.Sem.Surface.Elevated}" IsVisible="False"
                              RowDefinitions="*,*,*" ColumnDefinitions="*,*,*,*" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:hasweeknumbers">
            <Setter Property="MinWidth" Value="346" />
            <Style Selector="^ /template/ Grid#PART_ElementWeekNumberLabels ContentControl">
                <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground.Subtle}" />
                <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Xs}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Style>

    </ControlTheme>

</ResourceDictionary>