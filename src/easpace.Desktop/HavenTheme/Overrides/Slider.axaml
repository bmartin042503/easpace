<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:easpace.Desktop.Behaviors">
    
    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource Haven.Sem.Canvas}">
            <Slider Minimum="0" Maximum="1" MinWidth="200" MaxWidth="400" Value="0.5" />
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type Slider}"
                  TargetType="Slider">

        <Setter Property="behaviors:SliderBehavior.JumpToClick" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent}" />
        <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />

        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid x:Name="SliderContainer"
                              Margin="{TemplateBinding Padding}"
                              Background="Transparent">

                            <Grid
                                x:Name="HorizontalTemplate"
                                MinHeight="6"
                                ColumnDefinitions="Auto,Auto,*" RowDefinitions="6,Auto,6">

                                <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="3"
                                        Classes="elevated card" VerticalAlignment="Center"
                                        Height="16">
                                </Border>

                                <Track
                                    x:Name="PART_Track"
                                    Grid.Column="0"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Minimum="{TemplateBinding Minimum}"
                                    Maximum="{TemplateBinding Maximum}"
                                    Value="{TemplateBinding Value, Mode=TwoWay}"
                                    IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                    Orientation="Horizontal">

                                    <Thumb
                                        Name="thumb"
                                        Width="24"
                                        Height="24"
                                        Margin="0"
                                        Padding="0"
                                        Background="{DynamicResource Haven.Sem.Gradient.Accent}"
                                        BorderBrush="{DynamicResource Haven.Sem.Accent.Strong}"
                                        BorderThickness="0.75"
                                        DataContext="{TemplateBinding Value}" />

                                </Track>

                            </Grid>

                        </Grid>

                    </Border>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <Style
            Selector="^:pointerover /template/ Thumb#thumb,
                         ^:pressed /template/ Thumb#thumb">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Gradient.Accent}" />
        </Style>

        <Style Selector="^ /template/ Thumb#thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="20" />
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^ /template/ Thumb#thumb:pointerover, 
                 ^ /template/ Thumb#thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Gradient.Accent}" />
        </Style>

    </ControlTheme>

</ResourceDictionary>