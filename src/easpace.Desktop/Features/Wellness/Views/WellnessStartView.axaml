<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:easpace.Desktop.Services.Core"
             xmlns:vm="clr-namespace:easpace.Desktop.Features.Wellness.ViewModels"
             xmlns:utils="clr-namespace:easpace.Desktop.Utils"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="easpace.Desktop.Features.Wellness.Views.WellnessStartView"
             x:DataType="vm:WellnessStartViewModel"
             utils:ViewInitialization.Command="{Binding InitializeCommand}"
             Background="Transparent">

    <Grid Margin="{StaticResource Metrics.Spacing.Thickness.Lg}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="300" MinWidth="200" MaxWidth="600" />
        </Grid.ColumnDefinitions>

        <!-- Configuration -->
        <Border Grid.Column="0" Classes="card"
                Padding="{StaticResource Metrics.Spacing.Thickness.Xl}">

            <Grid RowDefinitions="*,*,*,*">

                <!-- Title -->
                <TextBlock Grid.Row="0" Classes="neutral fs2"
                           Text="{core:LocalizationService Key='Wellness.Title.Start'}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

                <!-- Exercises -->
                <StackPanel Grid.Row="1" Orientation="Vertical"
                            Spacing="{StaticResource Metrics.Spacing.Sm}">

                    <!-- Exercise selector and the way to manage exercises, which stays available when there are none -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xs}"
                                HorizontalAlignment="Center">

                        <ComboBox Width="240"
                                  IsEnabled="{Binding HasExercises}"
                                  SelectedItem="{Binding SelectedExercise}"
                                  ItemsSource="{Binding Exercises}"
                                  VerticalAlignment="Center">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>

                        <Button Classes="secondary icon" Command="{Binding ManageExercisesCommand}"
                                ToolTip.Tip="{core:LocalizationService Key='Wellness.Button.ManageExercises'}"
                                VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource PhosphorIcons.ListBullets}" />
                        </Button>

                    </StackPanel>

                    <Grid>

                        <!-- Exercise description -->
                        <TextBlock IsVisible="{Binding HasExercises}"
                                   Text="{Binding SelectedExercise.Description}"
                                   Classes="subtle neutral fs6" TextAlignment="Center" MaxWidth="540"
                                   TextWrapping="Wrap" />

                        <!-- 'No exercises available' text -->
                        <TextBlock IsVisible="{Binding ShowNoExercises}"
                                   Text="{core:LocalizationService Key='Wellness.Empty.NoExercises'}"
                                   Classes="strong danger fs5" TextAlignment="Center" />
                    </Grid>

                </StackPanel>

                <!-- Cycles of a repeating exercise, or the fixed duration of one that runs once -->
                <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xs}"
                                IsVisible="{Binding ShowCycleSelector}">

                        <TextBlock Classes="neutral fs4" VerticalAlignment="Center"
                                   Text="{core:LocalizationService Key='Wellness.Label.Cycles'}" />

                        <NumericUpDown Minimum="1" Maximum="{Binding MaximumCycles}"
                                       Value="{Binding SelectedCycles}"
                                       Increment="1" FormatString="0" ClipValueToMinMax="True"
                                       MinWidth="120" VerticalAlignment="Center" />

                        <TextBlock Classes="neutral fs4" VerticalAlignment="Center"
                                   Text="{Binding DurationText}" />

                    </StackPanel>

                    <TextBlock Classes="neutral fs4" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !ShowCycleSelector}"
                               Text="{Binding DurationText}" />

                </Grid>

                <!-- Begin session button -->
                <Button Grid.Row="3" Classes="primary regular"
                        Content="{core:LocalizationService Key='Wellness.Button.BeginSession'}"
                        Command="{Binding StartSessionCommand}"
                        HorizontalAlignment="Center" />

            </Grid>

        </Border>

        <!-- Horizontal splitter -->
        <GridSplitter Grid.Column="1"
                      Background="Transparent"
                      Width="{StaticResource Metrics.Spacing.Lg}"
                      ResizeDirection="Columns" />

        <Border Grid.Column="2" Classes="card">

            <Grid>

                <!-- No history view -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="{StaticResource Metrics.Spacing.Sm}"
                            IsVisible="{Binding ShowNoSessionEntries}">

                    <!-- Lotus icon -->
                    <PathIcon Data="{StaticResource PhosphorIcons.FlowerLotus}"
                              Width="{StaticResource Metrics.Icon.Size.Xl}"
                              Height="{StaticResource Metrics.Icon.Size.Xl}"
                              Foreground="{DynamicResource Sem.Foreground.Subtle}" />

                    <!-- 'Add entries' message -->
                    <TextBlock Text="{core:LocalizationService Key='Wellness.Empty.NoSessions'}"
                               Classes="subtle neutral trm-ellipsis" TextAlignment="Center" TextWrapping="Wrap" />

                </StackPanel>

                <!-- History -->
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="{StaticResource Metrics.Spacing.Sm}"
                      IsVisible="{Binding HasSessionEntries}">

                    <TextBlock Grid.Row="0" Text="{core:LocalizationService Key='Common.Title.History'}"
                               Classes="neutral fs3" TextAlignment="Center" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <ItemsRepeater ItemsSource="{Binding WellnessSessionEntries}">

                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:WellnessSessionEntryViewModel">

                                    <Border Classes="elevated card">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="{StaticResource Metrics.Spacing.Xs}">

                                            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4">

                                                <!-- Session details: exercise, duration and cycles, whichever are known -->
                                                <TextBlock Classes="neutral fs5"
                                                           Text="{Binding DetailsText}"
                                                           TextWrapping="Wrap" />

                                                <!-- Start date -->
                                                <TextBlock Classes="subtle neutral fs6"
                                                           Text="{Binding StartDate, Converter={StaticResource RelativeDateConverter}}"
                                                           ToolTip.Tip="{Binding TimestampText}" />

                                            </StackPanel>

                                            <!-- Delete button -->
                                            <Button Grid.Column="1" Classes="tertiary danger icon"
                                                    Command="{Binding $parent[UserControl].((vm:WellnessStartViewModel)DataContext).DeleteEntryCommand}"
                                                    CommandParameter="{Binding .}" VerticalAlignment="Top"
                                                    ToolTip.Tip="{core:LocalizationService Key='Common.Button.Delete'}">
                                                <PathIcon Data="{DynamicResource PhosphorIcons.Trash.Fill}" />
                                            </Button>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>

                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical"
                                             Spacing="{StaticResource Metrics.Spacing.Sm}" />
                            </ItemsRepeater.Layout>

                        </ItemsRepeater>
                    </ScrollViewer>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>