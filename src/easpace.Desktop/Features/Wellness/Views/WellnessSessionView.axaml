<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:easpace.Desktop.Services.Core"
             xmlns:vm="clr-namespace:easpace.Desktop.Features.Wellness.ViewModels"
             xmlns:behaviors="clr-namespace:easpace.Desktop.Behaviors"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="easpace.Desktop.Features.Wellness.Views.WellnessSessionView"
             x:DataType="vm:WellnessSessionViewModel"
             Background="Transparent">

    <!-- Session view -->
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="{StaticResource Metrics.Spacing.Xl}"
          Margin="80">

        <!-- Animated instruction text -->
        <TextBlock Grid.Row="0" Classes="neutral fs1 trm-ellipsis" TextWrapping="Wrap" MaxWidth="750"
                   behaviors:AnimatedTextBehavior.AnimatedText="{Binding InstructionText}"
                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Breathing elements -->
        <Grid Grid.Row="1" IsVisible="{Binding IsBreathing}"
              Width="192" Height="192" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Inner ellipse -->
            <Ellipse Width="96" Height="96"
                     Fill="{DynamicResource Sem.Brand.Strong}"
                     Opacity="1" VerticalAlignment="Center" HorizontalAlignment="Center" />

            <!-- Outer animated ellipse -->
            <Ellipse Width="{Binding BreathingCircleSize}"
                     Height="{Binding BreathingCircleSize}"
                     Fill="{DynamicResource Sem.Brand.Strong}"
                     Opacity="0.4" VerticalAlignment="Center" HorizontalAlignment="Center" />

            <!-- Phase seconds -->
            <TextBlock Classes="fs1" Foreground="{DynamicResource Sem.Surface.Brand}"
                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                       behaviors:AnimatedTextBehavior.AnimatedText="{Binding PhaseSecondsText}" />

        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              ColumnSpacing="{StaticResource Metrics.Spacing.Xl}"
              RowSpacing="{StaticResource Metrics.Spacing.Xl}">

            <!-- Timer -->
            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                       Classes="neutral fs3" Text="{Binding TimerText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding ShowWellnessTimer}" />
            
            <!-- Pause/Resume -->
            <Button Grid.Column="0" Grid.Row="1"
                    Classes="primary regular" Content="{Binding TimerToggleButtonText}"
                    Command="{Binding ToggleSessionTimerCommand}" />
            
            <!-- Stop -->
            <Button Grid.Column="1" Grid.Row="1" Classes="tertiary regular"
                    Content="{core:LocalizationService Key='Wellness.Button.EndSession'}"
                    Command="{Binding StopSessionCommand}" />

        </Grid>

        <!-- Warning text -->
        <TextBlock Grid.Row="3" Classes="subtle neutral fs4 trm-ellipsis" IsVisible="{Binding IsBreathing}"
                   Text="{core:LocalizationService Key='Wellness.Warning.Breathing'}" TextWrapping="Wrap"
                   TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600"
                   Opacity="0.8" />

    </Grid>

</UserControl>