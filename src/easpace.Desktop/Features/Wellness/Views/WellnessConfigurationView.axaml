<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:easpace.Desktop.Services.Core"
             xmlns:vm="clr-namespace:easpace.Desktop.Features.Wellness.ViewModels"
             xmlns:sessionVm="clr-namespace:easpace.Desktop.Features.Wellness.ViewModels.Session"
             xmlns:utils="clr-namespace:easpace.Desktop.Utils"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="easpace.Desktop.Features.Wellness.Views.WellnessConfigurationView"
             x:DataType="vm:WellnessConfigurationViewModel"
             utils:ViewInitialization.Command="{Binding InitializeCommand}"
             Background="Transparent">

    <Grid ColumnDefinitions="*,Auto">

        <!-- Configuration -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,*,*" ColumnDefinitions="Auto,*,Auto"
              Margin="{StaticResource Metrics.Spacing.Thickness.Lg}"
              ColumnSpacing="{StaticResource Metrics.Spacing.Lg}">

            <!-- Exercises button -->
            <Button Grid.Column="0" Grid.Row="0" Classes="tertiary regular"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Command="{Binding OpenExercisesCommand}">

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xxs}">

                    <PathIcon Data="{StaticResource PhosphorIcons.ListBullets}"
                              Width="{StaticResource Metrics.Icon.Size.Xs}"
                              Height="{StaticResource Metrics.Icon.Size.Xs}" />

                    <TextBlock Classes="fs6 medium"
                               Text="{core:LocalizationService Key='Wellness.Button.Exercises'}" />

                </StackPanel>

            </Button>

            <!-- History sidebar button -->
            <Button Grid.Row="0" Grid.Column="2" Classes="tertiary icon"
                    ToolTip.Tip="{core:LocalizationService Key='Common.Title.History'}"
                    VerticalAlignment="Top"
                    Command="{Binding ToggleHistoryCommand}">
                <PathIcon Data="{StaticResource PhosphorIcons.SquareHalf.Fill}" />
            </Button>

            <!-- Title -->
            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Classes="neutral fs2"
                       Text="{core:LocalizationService Key='Wellness.Title.Start'}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

            <!-- Exercises -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Orientation="Vertical"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource Metrics.Spacing.Sm}">

                <ComboBox MaxWidth="240"
                          IsEnabled="{Binding HasExercises}"
                          SelectedItem="{Binding SelectedExerciseViewModel}"
                          ItemsSource="{Binding WellnessExercises}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

                <Grid>

                    <!-- Exercise description -->
                    <TextBlock IsVisible="{Binding HasExercises}"
                               Text="{Binding SelectedExerciseViewModel.Description}"
                               Classes="subtle neutral fs6" TextAlignment="Center" MaxWidth="540"
                               TextWrapping="Wrap" />

                    <!-- 'No exercises available' text -->
                    <TextBlock IsVisible="{Binding ShowNoExercises}"
                               Text="{core:LocalizationService Key='WellnessExercise.Empty.Message'}"
                               Classes="strong danger fs5" TextAlignment="Center" />
                </Grid>

            </StackPanel>

            <!-- Begin session button -->
            <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Classes="primary regular"
                    Content="{core:LocalizationService Key='Wellness.Button.BeginSession'}"
                    Command="{Binding StartSessionCommand}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />

        </Grid>

        <Grid Grid.Column="1" Classes="history-drawer"
              Classes.open="{Binding IsHistoryOpen}">

            <Grid Classes="history-drawer-content">

                <!-- No history view -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="{StaticResource Metrics.Spacing.Sm}"
                            IsVisible="{Binding ShowNoSessionEntries}">

                    <!-- Timer icon -->
                    <PathIcon Data="{StaticResource PhosphorIcons.Timer.Fill}"
                              Width="{StaticResource Metrics.Icon.Size.Xl}"
                              Height="{StaticResource Metrics.Icon.Size.Xl}"
                              Foreground="{DynamicResource Sem.Foreground.Subtle}"/>

                    <!-- 'Add entries' message -->
                    <TextBlock Text="{core:LocalizationService Key='Wellness.Empty.Message'}"
                               Classes="subtle neutral trm-ellipsis" TextAlignment="Center" TextWrapping="Wrap" />

                </StackPanel>

                <!-- History -->
                <Grid RowDefinitions="Auto,*" Margin="{StaticResource Metrics.Spacing.Thickness.Lg}"
                      RowSpacing="{StaticResource Metrics.Spacing.Sm}"
                      IsVisible="{Binding HasSessionEntries}">

                    <TextBlock Grid.Row="0" Text="{core:LocalizationService Key='Common.Title.History'}"
                               Classes="neutral fs3" TextAlignment="Center" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <ItemsRepeater ItemsSource="{Binding WellnessSessionEntries}">

                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="sessionVm:WellnessSessionEntryViewModel">

                                    <Border Classes="elevated card">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="{StaticResource Metrics.Spacing.Xs}">

                                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4">

                                                <!-- Exercise session details -->
                                                <TextBlock Classes="subtle neutral fs6"
                                                           TextWrapping="Wrap">
                                                    <Run Text="{Binding ExerciseName}" />
                                                    <Run Text="•" />
                                                    <Run Text="{Binding DurationText}" />
                                                    <Run Text="•" />
                                                    <Run Text="{Binding CyclesText}" />
                                                </TextBlock>

                                                <!-- Start date -->
                                                <TextBlock Classes="subtle neutral fs6"
                                                           Text="{Binding StartDate, Converter={StaticResource RelativeDateConverter}}"
                                                           ToolTip.Tip="{Binding TimestampText}" />

                                            </StackPanel>

                                            <!-- Delete button -->
                                            <Button Grid.Column="2" Classes="tertiary danger icon"
                                                    Command="{Binding $parent[UserControl].((vm:WellnessConfigurationViewModel)DataContext).DeleteEntryCommand}"
                                                    CommandParameter="{Binding .}" VerticalAlignment="Top"
                                                    ToolTip.Tip="{core:LocalizationService Key='Common.Button.Delete'}">
                                                <PathIcon Data="{DynamicResource PhosphorIcons.Trash.Fill}" />
                                            </Button>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>

                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical"
                                             Spacing="{StaticResource Metrics.Spacing.Sm}" />
                            </ItemsRepeater.Layout>

                        </ItemsRepeater>
                    </ScrollViewer>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</UserControl>