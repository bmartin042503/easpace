<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:exercisesVm="clr-namespace:easpace.Desktop.Features.Wellness.ViewModels.Exercises"
             xmlns:core="clr-namespace:easpace.Desktop.Services.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="easpace.Desktop.Features.Wellness.Views.WellnessExercisesView"
             x:DataType="exercisesVm:WellnessExercisesViewModel">
    
    <Grid RowDefinitions="Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Margin="{StaticResource Metrics.Spacing.Thickness.Lg}">
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Sm}"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
            
            <!-- Navigate back button -->
            <Button Classes="primary icon" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Command="{Binding NavigateBackCommand}"
                    ToolTip.Tip="{core:LocalizationService Key='Common.Button.Back'}">
                <PathIcon Data="{StaticResource PhosphorIcons.ArrowLeft.Bold}" />
            </Button>
            
            <!-- Title -->
            <TextBlock Classes="neutral fs2" Text="{core:LocalizationService Key='Wellness.Button.Exercises'}" />
            
        </StackPanel>
        
    </Grid>
    
</UserControl>
