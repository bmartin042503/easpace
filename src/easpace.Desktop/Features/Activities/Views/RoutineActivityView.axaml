<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:easpace.Desktop.Services.Core"
             xmlns:viewModels="clr-namespace:easpace.Desktop.Features.Activities.ViewModels"
             xmlns:controls="clr-namespace:easpace.Desktop.Features.Activities.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:RoutineActivityViewModel"
             x:Class="easpace.Desktop.Features.Activities.Views.RoutineActivityView">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Metrics.Spacing.Md}"
          RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Metrics.Spacing.Sm}">

        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,Auto" 
              ColumnSpacing="{StaticResource Metrics.Spacing.Xs}">

            <!-- Title -->
            <TextBlock Grid.Column="0" Text="{Binding Name}"
                       Classes="neutral fs2 trm-ellipsis"
                       VerticalAlignment="Center"
                       ToolTip.Tip="{Binding Name}" />

            <!-- Archive status -->
            <TextBlock Grid.Column="1" IsVisible="{Binding IsArchived}"
                       Text="{core:LocalizationService Key='Activities.Label.Archived'}"
                       Classes="subtle neutral fs3 trm-ellipsis"
                       VerticalAlignment="Center" />

        </Grid>

        <!-- Interaction buttons -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                    Spacing="{StaticResource Metrics.Spacing.Sm}"
                    Margin="{StaticResource Metrics.Spacing.Thickness.Xxs}"
                    VerticalAlignment="Top" HorizontalAlignment="Right">

            <!-- Add button -->
            <Button Classes="primary regular"
                    Command="{Binding AddDataEntryCommand}"
                    ToolTip.Tip="{core:LocalizationService Key='Activities.Button.Add'}">
                
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xs}">

                    <PathIcon Data="{StaticResource PhosphorIcons.Plus.Bold}"
                              Width="{StaticResource Metrics.Icon.Size.Xxs}"
                              Height="{StaticResource Metrics.Icon.Size.Xxs}" />

                    <TextBlock Classes="fs6 medium"
                               Text="{core:LocalizationService Key='Activities.Button.Add'}" />

                </StackPanel>
                
            </Button>

            <!-- Dots Flyout -->
            <Button Classes="dots-flyout">

                <PathIcon Data="{StaticResource PhosphorIcons.DotsThree}"
                          Foreground="{DynamicResource Sem.Foreground.Muted}"
                          Width="{StaticResource Metrics.Icon.Size.Md}"
                          Height="{StaticResource Metrics.Icon.Size.Md}" />

                <Button.Flyout>
                    <Flyout>
                        <StackPanel Orientation="Vertical" Spacing="{StaticResource Metrics.Spacing.Sm}">

                            <!-- Edit button -->
                            <Button Classes="primary regular" HorizontalAlignment="Stretch"
                                    Command="{Binding EditCommand}"
                                    ToolTip.Tip="{core:LocalizationService Key='Common.Button.Edit'}">

                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xs}">

                                    <PathIcon Data="{StaticResource PhosphorIcons.Pencil.Fill}"
                                              Width="{StaticResource Metrics.Icon.Size.Xxs}"
                                              Height="{StaticResource Metrics.Icon.Size.Xxs}" />

                                    <TextBlock Classes="fs6 medium"
                                               Text="{core:LocalizationService Key='Common.Button.Edit'}" />

                                </StackPanel>

                            </Button>

                            <!-- Archive/Restore button -->
                            <Button Classes="primary regular" HorizontalAlignment="Stretch"
                                    Command="{Binding ToggleArchiveCommand}">

                                <Panel>
                                    <StackPanel IsVisible="{Binding !IsArchived}"
                                                Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xs}"
                                                ToolTip.Tip="{core:LocalizationService Key='Common.Button.Archive'}">

                                        <PathIcon Data="{StaticResource PhosphorIcons.Archive.Fill}"
                                                  Width="{StaticResource Metrics.Icon.Size.Xxs}"
                                                  Height="{StaticResource Metrics.Icon.Size.Xxs}" />

                                        <TextBlock Classes="fs6 medium"
                                                   Text="{core:LocalizationService Key='Common.Button.Archive'}" />

                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding IsArchived}"
                                                Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xs}"
                                                ToolTip.Tip="{core:LocalizationService Key='Common.Button.Restore'}">

                                        <PathIcon Data="{StaticResource PhosphorIcons.BoxArrowUp.Fill}"
                                                  Width="{StaticResource Metrics.Icon.Size.Xxs}"
                                                  Height="{StaticResource Metrics.Icon.Size.Xxs}" />

                                        <TextBlock Classes="fs6 medium"
                                                   Text="{core:LocalizationService Key='Common.Button.Restore'}" />

                                    </StackPanel>
                                </Panel>

                            </Button>

                            <!-- Delete button -->
                            <Button Classes="danger regular" HorizontalAlignment="Stretch"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip.Tip="{core:LocalizationService Key='Common.Button.Delete'}">

                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xs}">

                                    <PathIcon Data="{StaticResource PhosphorIcons.Trash.Fill}"
                                              Width="{StaticResource Metrics.Icon.Size.Xxs}"
                                              Height="{StaticResource Metrics.Icon.Size.Xxs}" />

                                    <TextBlock Classes="fs6 medium"
                                               Text="{core:LocalizationService Key='Common.Button.Delete'}" />

                                </StackPanel>

                            </Button>

                        </StackPanel>
                    </Flyout>
                </Button.Flyout>

            </Button>

        </StackPanel>

        <!-- Calendar days -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="Auto,*"
              RowSpacing="{StaticResource Metrics.Spacing.Xs}"
              MinWidth="500">

            <!-- Day names -->
            <Border Grid.Row="0"
                    BorderThickness="{StaticResource Metrics.Border.Thickness.Bottom}"
                    BorderBrush="{DynamicResource Sem.Border}">
                <UniformGrid Rows="1" Margin="{StaticResource Metrics.Spacing.Thickness.Bottom.Xxs}">
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='RoutineActivity.CalendarDay.MondayShort'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='RoutineActivity.CalendarDay.TuesdayShort'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='RoutineActivity.CalendarDay.WednesdayShort'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='RoutineActivity.CalendarDay.ThursdayShort'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='RoutineActivity.CalendarDay.FridayShort'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='RoutineActivity.CalendarDay.SaturdayShort'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='RoutineActivity.CalendarDay.SundayShort'}" />
                </UniformGrid>
            </Border>

            <!-- Month items -->
            <ScrollViewer Grid.Row="1">
                <ItemsRepeater ItemsSource="{Binding RoutineMonths}">

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <controls:RoutineMonthItem MonthData="{Binding}"
                                                       Margin="{StaticResource Metrics.Spacing.Thickness.Wide.Xs}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>

                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical"
                                     Spacing="{StaticResource Metrics.Spacing.Xs}" />
                    </ItemsRepeater.Layout>

                </ItemsRepeater>
            </ScrollViewer>

        </Grid>

        <!-- Calendar legend -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Spacing="{StaticResource Metrics.Spacing.Sm}"
                    Margin="{StaticResource Metrics.Spacing.Thickness.Wide.Xs}">

            <!-- Completed legend -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xxs}">
                <Border Classes="calendar-legend-box completed" />
                <TextBlock Classes="neutral fs6"
                           Text="{core:LocalizationService Key='RoutineActivity.CalendarLegend.Completed'}" />
            </StackPanel>

            <!-- Not completed legend -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xxs}">
                <Border Classes="calendar-legend-box not-completed" />
                <TextBlock Classes="neutral fs6"
                           Text="{core:LocalizationService Key='RoutineActivity.CalendarLegend.NotCompleted'}" />
            </StackPanel>

            <!-- Today legend -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xxs}">
                <Border Classes="calendar-legend-box today" />
                <TextBlock Classes="neutral fs6"
                           Text="{core:LocalizationService Key='RoutineActivity.CalendarLegend.Today'}" />
            </StackPanel>

        </StackPanel>

    </Grid>

</UserControl>