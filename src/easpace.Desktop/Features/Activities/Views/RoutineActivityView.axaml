<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:easpace.Desktop.Services.Core"
             xmlns:viewModels="clr-namespace:easpace.Desktop.Features.Activities.ViewModels"
             xmlns:controls="clr-namespace:easpace.Desktop.Features.Activities.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:RoutineActivityViewModel"
             x:Class="easpace.Desktop.Features.Activities.Views.RoutineActivityView">

    <Grid RowDefinitions="*,Auto" RowSpacing="{StaticResource Metrics.Spacing.Xl}"
          Margin="0,22,0,0">

        <!-- Calendar days -->
        <Grid Grid.Row="0" RowDefinitions="Auto,*" RowSpacing="{StaticResource Metrics.Spacing.Xs}"
              MinWidth="500">

            <!-- Day names -->
            <Border Grid.Row="0"
                    BorderThickness="{StaticResource Metrics.Border.Thickness.Bottom}"
                    BorderBrush="{DynamicResource Sem.Border}">
                <UniformGrid Rows="1" Margin="{StaticResource Metrics.Spacing.Thickness.Bottom.Xxs}">
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='Common.WeekdayShort.Monday'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='Common.WeekdayShort.Tuesday'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='Common.WeekdayShort.Wednesday'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='Common.WeekdayShort.Thursday'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='Common.WeekdayShort.Friday'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='Common.WeekdayShort.Saturday'}" />
                    <TextBlock Classes="neutral fs5" TextAlignment="Center"
                               Text="{core:LocalizationService Key='Common.WeekdayShort.Sunday'}" />
                </UniformGrid>
            </Border>

            <!-- Month items -->
            <ScrollViewer Grid.Row="1">
                <ItemsRepeater ItemsSource="{Binding RoutineMonths}">

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <controls:RoutineMonthItem MonthData="{Binding}"
                                                       Margin="{StaticResource Metrics.Spacing.Thickness.Wide.Xs}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>

                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical"
                                     Spacing="{StaticResource Metrics.Spacing.Xs}" />
                    </ItemsRepeater.Layout>

                </ItemsRepeater>
            </ScrollViewer>

        </Grid>

        <!-- Calendar legend -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    Spacing="{StaticResource Metrics.Spacing.Sm}"
                    Margin="{StaticResource Metrics.Spacing.Thickness.Wide.Xs}">

            <!-- Completed legend -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xxs}">
                <Border Classes="calendar-legend-box completed" />
                <TextBlock Classes="neutral fs6"
                           Text="{core:LocalizationService Key='Activities.RoutineState.Completed'}" />
            </StackPanel>

            <!-- Not completed legend -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xxs}">
                <Border Classes="calendar-legend-box not-completed" />
                <TextBlock Classes="neutral fs6"
                           Text="{core:LocalizationService Key='Activities.RoutineState.NotCompleted'}" />
            </StackPanel>

            <!-- Today legend -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xxs}">
                <Border Classes="calendar-legend-box today" />
                <TextBlock Classes="neutral fs6"
                           Text="{core:LocalizationService Key='Activities.RoutineCalendar.Today'}" />
            </StackPanel>

        </StackPanel>

    </Grid>

</UserControl>