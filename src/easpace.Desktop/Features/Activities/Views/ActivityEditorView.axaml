<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dataTemplates="clr-namespace:easpace.Desktop.DataTemplates"
             xmlns:core="clr-namespace:easpace.Desktop.Services.Core"
             xmlns:converters="clr-namespace:easpace.Desktop.Converters"
             xmlns:vm="clr-namespace:easpace.Desktop.Features.Activities.ViewModels"
             xmlns:vmDataEntries="clr-namespace:easpace.Desktop.Features.Activities.ViewModels.DataEntries"
             xmlns:controls="clr-namespace:easpace.Desktop.HavenTheme.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ActivityEditorViewModel"
             x:Class="easpace.Desktop.Features.Activities.Views.ActivityEditorView">

    <UserControl.Resources>

        <!-- TrendActivity edit form -->
        <DataTemplate x:Key="TrendTemplate" x:DataType="vm:ActivityEditorViewModel">

            <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Lg}"
                        HorizontalAlignment="Stretch">

                <!-- Unit input -->
                <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Xxs}"
                            HorizontalAlignment="Stretch">

                    <TextBlock Classes="neutral fs4" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               Text="{core:LocalizationService Key='Activities.Label.Unit'}" />

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource Haven.Scale.Input.MaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding Unit}"
                                 HorizontalAlignment="Stretch"
                                 PlaceholderText="{core:LocalizationService Key='Activities.Input.UnitPlaceholder'}"
                                 MaxLength="16" />
                    </Grid>

                </StackPanel>

                <!-- Aggregation selection -->
                <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Xxs}"
                            HorizontalAlignment="Stretch">

                    <!-- Label -->
                    <TextBlock Classes="neutral fs4" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               Text="{core:LocalizationService Key='Activities.Label.Aggregation'}" />

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource Haven.Scale.Input.MaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" ItemsSource="{Binding Aggregations}"
                                  SelectedItem="{Binding SelectedTrendAggregation}"
                                  HorizontalAlignment="Stretch">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </Grid>

                </StackPanel>

                <!-- Target checkbox -->
                <CheckBox Content="{core:LocalizationService Key='Activities.CheckBox.Target'}"
                          IsChecked="{Binding IsTargetChecked}" HorizontalAlignment="Left" />

                <!-- Target value input -->
                <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Xxs}"
                            HorizontalAlignment="Stretch" IsVisible="{Binding IsTargetChecked}">

                    <TextBlock Classes="neutral fs4" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               Text="{core:LocalizationService Key='Activities.Label.TargetValue'}" />

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource Haven.Scale.Input.MaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <NumericUpDown Grid.Column="0" Value="{Binding Target}"
                                       HorizontalAlignment="Stretch"
                                       Increment="1" FormatString="0.##"
                                       PlaceholderText="{core:LocalizationService Key='Activities.Input.TargetPlaceholder'}"
                                       Minimum="1" Maximum="10000000" />
                    </Grid>

                </StackPanel>

            </StackPanel>

        </DataTemplate>

        <!-- MilestoneActivity edit form -->
        <DataTemplate x:Key="MilestoneTemplate" x:DataType="vm:ActivityEditorViewModel">

            <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Lg}"
                        HorizontalAlignment="Stretch">

                <!-- Unit input -->
                <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Xxs}"
                            HorizontalAlignment="Stretch">

                    <TextBlock Classes="neutral fs4" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               Text="{core:LocalizationService Key='Activities.Label.Unit'}" />

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource Haven.Scale.Input.MaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding Unit}"
                                 HorizontalAlignment="Stretch"
                                 PlaceholderText="{core:LocalizationService Key='Activities.Input.UnitPlaceholder'}"
                                 MaxLength="16" />
                    </Grid>

                </StackPanel>

                <!-- Target value input -->
                <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Xxs}"
                            HorizontalAlignment="Stretch">

                    <TextBlock Classes="neutral fs4" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               Text="{core:LocalizationService Key='Activities.Label.TargetValue'}" />

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource Haven.Scale.Input.MaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <NumericUpDown Grid.Column="0" Value="{Binding Target}"
                                       HorizontalAlignment="Stretch"
                                       Increment="1" FormatString="0.##"
                                       PlaceholderText="{core:LocalizationService Key='Activities.Input.TargetPlaceholder'}"
                                       Minimum="1" Maximum="10000000" />
                    </Grid>

                </StackPanel>

                <!-- Start date input -->
                <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Xxs}"
                            HorizontalAlignment="Stretch">

                    <TextBlock Classes="neutral fs4" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               Text="{core:LocalizationService Key='Activities.NumericActivity.StartDate'}" />

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource Haven.Scale.Input.MaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <CalendarDatePicker Grid.Column="0" SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"
                                            PlaceholderText="{core:LocalizationService Key='Activities.Input.DatePlaceholder'}" />
                    </Grid>

                </StackPanel>

                <!-- Target date input -->
                <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Xxs}"
                            HorizontalAlignment="Stretch">

                    <TextBlock Classes="neutral fs4" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               Text="{core:LocalizationService Key='Activities.Label.TargetDate'}" />

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource Haven.Scale.Input.MaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <CalendarDatePicker Grid.Column="0" SelectedDate="{Binding TargetDate, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"
                                            PlaceholderText="{core:LocalizationService Key='Activities.Input.DatePlaceholder'}" />
                    </Grid>

                </StackPanel>

            </StackPanel>

        </DataTemplate>

        <!-- RoutineActivity edit form -->
        <!-- Left it empty, as its only content is the Name textbox which is already in the view -->
        <DataTemplate x:Key="RoutineTemplate" x:DataType="vm:ActivityEditorViewModel" />

        <!-- Converts ActivityType to a template (selects the correct form layout) -->
        <converters:ActivityTypeToTemplateConverter
            x:Key="ActivityTypeToTemplateConverter"
            TrendTemplate="{StaticResource TrendTemplate}"
            MilestoneTemplate="{StaticResource MilestoneTemplate}"
            RoutineTemplate="{StaticResource RoutineTemplate}" />

    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto"
          RowSpacing="{StaticResource Haven.Scale.Spacing.Md}"
          ColumnSpacing="{StaticResource Haven.Scale.Spacing.Md}">

        <!-- Title -->
        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding TitleText}"
                   Classes="neutral fs2 trm-ellipsis" ToolTip.Tip="{Binding TitleText}" />

        <!-- Buttons -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                    Spacing="{StaticResource Haven.Scale.Spacing.Xs}">

            <!-- Cancel button -->
            <Button Classes="secondary icon" Command="{Binding CancelCommand}"
                    ToolTip.Tip="{core:LocalizationService Key='Common.Button.Cancel'}">
                <PathIcon Data="{StaticResource Haven.PhosphorIcons.X}" />
            </Button>

            <!-- Save button -->
            <Button Classes="primary icon" Command="{Binding SaveCommand}"
                    ToolTip.Tip="{core:LocalizationService Key='Common.Button.Save'}">
                <PathIcon Data="{StaticResource Haven.PhosphorIcons.Check}" />
            </Button>

        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Lg}"
                        HorizontalAlignment="Stretch">

                <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Lg}"
                            HorizontalAlignment="Stretch">

                    <!-- Name input -->
                    <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Xxs}"
                                HorizontalAlignment="Stretch">

                        <TextBlock Classes="neutral fs4" TextWrapping="Wrap"
                                   HorizontalAlignment="Stretch"
                                   Text="{core:LocalizationService Key='Activities.Label.Name'}" />

                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="{StaticResource Haven.Scale.Input.MaxWidth}" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding Name}"
                                     HorizontalAlignment="Stretch"
                                     PlaceholderText="{core:LocalizationService Key='Activities.Input.NamePlaceholder'}"
                                     MaxLength="64" />
                        </Grid>

                    </StackPanel>

                    <!-- Type selection -->
                    <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Xxs}"
                                HorizontalAlignment="Stretch">

                        <TextBlock Classes="neutral fs4" TextWrapping="Wrap"
                                   HorizontalAlignment="Stretch"
                                   Text="{core:LocalizationService Key='Activities.Label.Type'}" />

                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="{StaticResource Haven.Scale.Input.MaxWidth}" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" ItemsSource="{Binding ActivityTypes}"
                                      SelectedItem="{Binding SelectedType}"
                                      IsEnabled="{Binding IsCreatingNew}"
                                      HorizontalAlignment="Stretch">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                            </ComboBox>
                        </Grid>

                    </StackPanel>

                    <!-- Rest of the form -->
                    <ContentControl Content="{Binding .}"
                                    HorizontalContentAlignment="Stretch"
                                    HorizontalAlignment="Stretch"
                                    ContentTemplate="{Binding SelectedType, Converter={StaticResource ActivityTypeToTemplateConverter}}" />

                </StackPanel>

                <!-- Separator line -->
                <Separator Height="1" Background="{DynamicResource Haven.Sem.Border}"
                           IsVisible="{Binding !IsCreatingNew}" />

                <!-- Data entries -->
                <Border Classes="card" Background="{DynamicResource Haven.Sem.Surface.Elevated}"
                        IsVisible="{Binding !IsCreatingNew}">
                    <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Sm}">

                        <!-- Label -->
                        <TextBlock Classes="neutral fs4" Text="{Binding DataEntriesLabel}" />

                        <!-- Items -->
                        <ItemsRepeater ItemsSource="{Binding DataEntries}">

                            <ItemsRepeater.Resources>
                                <dataTemplates:TemplateSelector x:Key="DataEntrySelector">

                                    <!-- NumericDataEntry template -->
                                    <DataTemplate x:Key="NumericActivityDataEntryViewModel"
                                                  x:DataType="vmDataEntries:NumericActivityDataEntryViewModel">

                                        <controls:DataEntryListItem
                                            Value="{Binding Value}"
                                            Timestamp="{Binding Timestamp, StringFormat='{}{0:yyyy. MM. dd. HH:mm:ss}'}"
                                            DeleteCommand="{Binding $parent[UserControl].((vm:ActivityEditorViewModel)DataContext).DeleteDataEntryCommand}"
                                            EditCommand="{Binding $parent[UserControl].((vm:ActivityEditorViewModel)DataContext).EditDataEntryCommand}"
                                            CommandsParameter="{Binding .}" />

                                    </DataTemplate>

                                    <!-- RoutineDataEntry template -->
                                    <DataTemplate x:Key="RoutineActivityDataEntryViewModel"
                                                  x:DataType="vmDataEntries:RoutineActivityDataEntryViewModel">

                                        <controls:DataEntryListItem
                                            Value="{Binding State, Converter={StaticResource EnumToLocalizedConverter}}"
                                            Timestamp="{Binding Timestamp, StringFormat='{}{0:yyyy. MM. dd. HH:mm:ss}'}"
                                            DeleteCommand="{Binding $parent[UserControl].((vm:ActivityEditorViewModel)DataContext).DeleteDataEntryCommand}"
                                            EditCommand="{Binding $parent[UserControl].((vm:ActivityEditorViewModel)DataContext).EditDataEntryCommand}"
                                            CommandsParameter="{Binding .}" />

                                    </DataTemplate>

                                </dataTemplates:TemplateSelector>
                            </ItemsRepeater.Resources>

                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vmDataEntries:ActivityDataEntryViewModel">

                                    <ContentControl Content="{Binding .}"
                                                    ContentTemplate="{StaticResource DataEntrySelector}" />

                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>

                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical"
                                             Spacing="{StaticResource Haven.Scale.Spacing.Xxs}" />
                            </ItemsRepeater.Layout>

                        </ItemsRepeater>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>