<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:easpace.Desktop.Services"
             xmlns:vmDialogs="clr-namespace:easpace.Desktop.Features.Activities.ViewModels.Dialogs"
             x:DataType="vmDialogs:RoutineEntryDialogViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
             MaxWidth="550" MaxHeight="400"
             Background="{StaticResource Haven.Scale.Transparent}"
             x:Class="easpace.Desktop.Features.Activities.Views.Dialogs.RoutineEntryDialogView">

    <Design.DataContext>
        <vmDialogs:RoutineEntryDialogViewModel />
    </Design.DataContext>

    <Border x:Name="DialogRootBorder" Classes="card"
            Padding="{StaticResource Haven.Scale.Spacing.Thickness.Sm}"
            BorderThickness="0">

        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="{StaticResource Haven.Scale.Spacing.Xl}">

            <!-- Title -->
            <TextBlock x:Name="DialogRootTitle" Grid.Row="0" Classes="neutral fs3 trm-ellipsis"
                       Text="{Binding Title}"
                       TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center" />

            <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Sm}"
                        HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Haven.Scale.Spacing.Sm}">

                    <!-- Date input -->
                    <CalendarDatePicker SelectedDate="{Binding SelectedDate}"
                                        HorizontalAlignment="Stretch"
                                        PlaceholderText="{services:LocalizationService Key='Activities.EntryDialog.DatePlaceholder'}"
                                        DisplayDateEnd="{Binding MaxAllowedDate}"
                                        MinHeight="37" />

                    <!-- Time picker -->
                    <TimePicker SelectedTime="{Binding SelectedTime}"
                                ClockIdentifier="24HourClock"
                                MinHeight="37" />

                </StackPanel>

                <!-- Routine state selection -->
                <ComboBox ItemsSource="{Binding States}"
                          SelectedItem="{Binding SelectedState}"
                          Width="{StaticResource Haven.Scale.Input.MinWidth}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding Converter={StaticResource EnumToLocalizedConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource Haven.Scale.Spacing.Xs}"
                        HorizontalAlignment="Right">

                <!-- Cancel button -->
                <Button Classes="secondary regular" Content="{Binding CancelText}"
                        Command="{Binding CancelCommand}" />

                <!-- Confirm button -->
                <Button Classes="primary regular" Content="{Binding ConfirmText}"
                        Command="{Binding ConfirmCommand}" />

            </StackPanel>

        </Grid>

    </Border>

</UserControl>