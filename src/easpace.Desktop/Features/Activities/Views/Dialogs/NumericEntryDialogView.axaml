<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmDialogs="clr-namespace:easpace.Desktop.Features.Activities.ViewModels.Dialogs"
             xmlns:core="clr-namespace:easpace.Desktop.Services.Core"
             x:DataType="vmDialogs:NumericEntryDialogViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
             MinWidth="300"
             MaxWidth="450" MaxHeight="400"
             Background="Transparent"
             x:Class="easpace.Desktop.Features.Activities.Views.Dialogs.NumericEntryDialogView">

    <Design.DataContext>
        <vmDialogs:NumericEntryDialogViewModel />
    </Design.DataContext>

    <Border x:Name="DialogRootBorder" Classes="dialog card"
            Padding="{StaticResource Metrics.Spacing.Thickness.Sm}"
            BorderThickness="0">

        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="{StaticResource Metrics.Spacing.Xxl}">

            <!-- Title -->
            <TextBlock x:Name="DialogRootTitle" Grid.Row="0"
                       Classes="neutral fs3 trm-ellipsis" Text="{Binding Title}"
                       TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center" />

            <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="{StaticResource Metrics.Spacing.Sm}">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Metrics.Spacing.Sm}">

                    <!-- Date input -->
                    <CalendarDatePicker Grid.Column="0" SelectedDate="{Binding SelectedDate}"
                                        HorizontalAlignment="Stretch" Width="160"
                                        PlaceholderText="{core:LocalizationService Key='Activities.EntryDialog.DatePlaceholder'}"
                                        DisplayDateEnd="{Binding MaxAllowedDate}" />

                    <!-- Time picker -->
                    <TimePicker Grid.Column="1" SelectedTime="{Binding SelectedTime}"
                                ClockIdentifier="24HourClock" />

                </Grid>

                <DockPanel>

                    <!-- Unit label -->
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding UnitText}" VerticalAlignment="Center"
                               TextAlignment="Center" Foreground="{DynamicResource Sem.Foreground}"
                               IsVisible="{Binding UnitText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Margin="8,0,0,0" />

                    <!-- Numeric value input -->
                    <NumericUpDown Value="{Binding NumericValue}"
                                   HorizontalAlignment="Stretch" Increment="1" FormatString="0.##"
                                   PlaceholderText="{core:LocalizationService Key='Activities.EntryDialog.NumericValuePlaceholder'}" />

                </DockPanel>

            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xs}"
                        HorizontalAlignment="Right">

                <!-- Cancel button -->
                <Button Classes="secondary regular" Content="{Binding CancelText}"
                        Command="{Binding CancelCommand}" />

                <!-- Confirm button -->
                <Button Classes="primary regular" Content="{Binding ConfirmText}"
                        Command="{Binding ConfirmCommand}" />

            </StackPanel>

        </Grid>

    </Border>

</UserControl>