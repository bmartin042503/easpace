<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:easpace.Desktop.Features.Journal.ViewModels"
             xmlns:services="clr-namespace:easpace.Desktop.Services"
             xmlns:utils="clr-namespace:easpace.Desktop.Utils"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="easpace.Desktop.Features.Journal.Views.JournalPageView"
             x:DataType="vm:JournalPageViewModel"
             Background="{DynamicResource Haven.Sem.Canvas}"
             utils:ViewInitialization.Command="{Binding InitializeAsync}">

    <Border Classes="card"
            Classes.gradient="{Binding !IsEditing}"
            Margin="{StaticResource Haven.Scale.Spacing.Thickness.Lg}">

        <Grid ColumnSpacing="{StaticResource Haven.Scale.Spacing.Xs}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" MaxWidth="600" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,*"
                  RowSpacing="{StaticResource Haven.Scale.Spacing.Lg}">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="{StaticResource Haven.Scale.Spacing.Sm}">
                    
                    <!-- Search box -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="{services:LocalizationService Key='Journal.Search.Placeholder'}"
                             MinWidth="140">
                        <TextBox.InnerRightContent>
                            <PathIcon Data="{StaticResource Haven.PhosphorIcons.MagnifyingGlass}" />
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <!-- Add button -->
                    <Button Grid.Column="1"
                            Classes="primary icon"
                            Command="{Binding AddEntryCommand}"
                            IsEnabled="{Binding !IsEditing}"
                            ToolTip.Tip="{services:LocalizationService Key='Common.Button.Add'}">
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.Plus.Bold}" />
                    </Button>
                    
                </Grid>

                <!-- No entries view -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="{StaticResource Haven.Scale.Spacing.Sm}"
                            IsVisible="{Binding !HasEntries}">
                    <PathIcon Data="{StaticResource Haven.PhosphorIcons.File}"
                              Width="{StaticResource Haven.Scale.Icon.Size.Xl}"
                              Height="{StaticResource Haven.Scale.Icon.Size.Xl}"
                              Foreground="{DynamicResource Haven.Sem.Foreground.Subtle}" />
                    <TextBlock Text="{services:LocalizationService Key='Journal.Empty.Message'}"
                               Classes="subtle neutral trm-ellipsis"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Entries -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding HasEntries}">
                    
                    <ListBox Classes="journal list"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             IsEnabled="{Binding !IsEditing}">
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:JournalEntryViewModel">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Classes="journal-list-item fs5 trm-ellipsis"
                                               Text="{Binding Title}" />
                                    <TextBlock Classes="journal-sub-list-item fs6 trm-ellipsis"
                                               Text="{Binding CreatedAt, Converter={StaticResource RelativeDateConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"
                                            Spacing="{StaticResource Haven.Scale.Spacing.Sm}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        
                    </ListBox>
                    
                </ScrollViewer>
            </Grid>

            <!-- Vertical splitter -->
            <GridSplitter Grid.Column="1"
                          Classes="vertical"
                          ResizeDirection="Columns" />

            <!-- Reading view -->
            <Grid Grid.Column="2"
                  RowDefinitions="Auto,*"
                  ColumnDefinitions="*,Auto"
                  RowSpacing="{StaticResource Haven.Scale.Spacing.Md}"
                  ColumnSpacing="{StaticResource Haven.Scale.Spacing.Md}"
                  IsVisible="{Binding !IsEditing}">
                
                <!-- Title -->
                <SelectableTextBlock Grid.Row="0"
                                     Grid.Column="0"
                                     Classes="neutral fs2 trm-ellipsis"
                                     Text="{Binding ActiveEntry.Title}" />

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{StaticResource Haven.Scale.Spacing.Xs}"
                            IsVisible="{Binding HasActiveEntry}">
                    
                    <!-- Delete button -->
                    <Button Classes="tertiary danger icon"
                            Command="{Binding DeleteEntryCommand}"
                            ToolTip.Tip="{services:LocalizationService Key='Common.Button.Delete'}">
                        <PathIcon Data="{DynamicResource Haven.PhosphorIcons.Trash.Fill}" />
                    </Button>

                    <!-- Edit button -->
                    <Button Classes="tertiary icon"
                            Command="{Binding EditEntryCommand}"
                            ToolTip.Tip="{services:LocalizationService Key='Common.Button.Edit'}">
                        <PathIcon Data="{DynamicResource Haven.PhosphorIcons.Pencil.Fill}" />
                    </Button>
                    
                </StackPanel>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                    <SelectableTextBlock TextWrapping="Wrap"
                                         Classes="neutral fs4 trm-ellipsis"
                                         Text="{Binding ActiveEntry.Content}" />
                </ScrollViewer>
            </Grid>

            <!-- Editor view -->
            <Grid Grid.Column="2"
                  RowDefinitions="Auto,*"
                  ColumnDefinitions="*,Auto"
                  RowSpacing="{StaticResource Haven.Scale.Spacing.Md}"
                  ColumnSpacing="{StaticResource Haven.Scale.Spacing.Md}"
                  IsVisible="{Binding IsEditing}">
                
                <!-- Title -->
                <TextBox Grid.Row="0"
                         Grid.Column="0"
                         Text="{Binding Editor.Title, Mode=TwoWay}"
                         Classes="journal-edit fs2"
                         PlaceholderText="{services:LocalizationService Key='Journal.Input.TitlePlaceholder'}"
                         VerticalAlignment="Center" />

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{StaticResource Haven.Scale.Spacing.Xs}">
                    
                    <!-- Cancel button -->
                    <Button Classes="secondary icon"
                            Command="{Binding Editor.CancelCommand}"
                            ToolTip.Tip="{services:LocalizationService Key='Common.Button.Cancel'}">
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.X}" />
                    </Button>

                    <!-- Save button -->
                    <Button Classes="primary icon"
                            Command="{Binding Editor.SaveCommand}"
                            ToolTip.Tip="{services:LocalizationService Key='Common.Button.Save'}">
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.Check}" />
                    </Button>
                    
                </StackPanel>

                <!-- Content -->
                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                         Text="{Binding Editor.Content, Mode=TwoWay}"
                         Classes="journal-edit fs4" AcceptsReturn="True" TextWrapping="Wrap"
                         PlaceholderText="{services:LocalizationService Key='Journal.Input.ContentPlaceholder'}"
                         VerticalAlignment="Stretch" />
            </Grid>
        </Grid>
    </Border>
</UserControl>