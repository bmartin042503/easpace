<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:easpace.Desktop.Services"
                    xmlns:dataTemplates="clr-namespace:easpace.Desktop.DataTemplates"
                    xmlns:activities="clr-namespace:easpace.Desktop.ViewModels.Activities"
                    xmlns:controls="clr-namespace:easpace.Desktop.Controls">

    <!-- Template selector of Activity item -->
    <dataTemplates:TemplateSelector x:Key="ActivityItemSelector">

        <!-- Template of Trend Activity -->
        <DataTemplate x:Key="TrendActivityViewModel" x:DataType="activities:TrendActivityViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ActivityTitleSpacing}"
                  RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource ActivityTitleSpacing}">

                <!-- Title -->
                <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Activity.Title}"
                           FontSize="{DynamicResource ActivityTitleFontSize}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Neutral700}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Interaction buttons -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            Spacing="{DynamicResource InteractionButtonsSpacing}"
                            VerticalAlignment="Center">

                    <!-- Add button -->
                    <Button Classes="icon-btn primary">
                        <PathIcon Data="{DynamicResource PlusIcon}" />
                    </Button>

                    <!-- Edit button -->
                    <Button Classes="icon-btn secondary">
                        <PathIcon Data="{DynamicResource PencilFillIcon}" />
                    </Button>

                </StackPanel>

                <!-- Details -->
                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Spacing="12">

                    <!-- Current value -->
                    <TextBlock FontSize="{DynamicResource ActivityTextFontSize}"
                               VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Activity.LastEntry.Value" />
                                <Binding Path="Activity.Unit" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- Target value -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Foreground="{DynamicResource Primary600}"
                                   FontSize="16"
                                   FontWeight="Medium" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="Activity.TargetValue" />
                                    <Binding Path="Activity.Unit" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <PathIcon
                            Width="18" Height="18"
                            Data="{DynamicResource TargetIcon}"
                            Foreground="{DynamicResource Primary600}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                </StackPanel>

                <!-- Time Range Selection (segmented control) -->
                <ListBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Classes="chart-segmented-control"
                         HorizontalAlignment="Left" Margin="0,10,0,0"
                         ItemsSource="{Binding TimeRanges}"
                         SelectedItem="{Binding SelectedTimeRange}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TimeRangeConverter}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

                <!-- Chart -->
                <controls:TrendChart Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                     Target="{Binding Activity.TargetValue}"
                                     Unit="{Binding Activity.Unit}"
                                     Entries="{Binding ChartEntries}"
                                     Margin="0,20,0,0" />

            </Grid>
        </DataTemplate>

        <!-- Template of Milestone Activity -->
        <DataTemplate x:Key="MilestoneActivityViewModel" x:DataType="activities:MilestoneActivityViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ActivityTitleSpacing}"
                  RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource ActivityTitleSpacing}">

                <!-- Title -->
                <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Activity.Title}"
                           FontSize="{DynamicResource ActivityTitleFontSize}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Neutral700}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Interaction buttons -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            Spacing="{DynamicResource InteractionButtonsSpacing}"
                            VerticalAlignment="Center">

                    <!-- Add button -->
                    <Button Classes="icon-btn primary">
                        <PathIcon Data="{DynamicResource PlusIcon}" />
                    </Button>

                    <!-- Edit button -->
                    <Button Classes="icon-btn secondary">
                        <PathIcon Data="{DynamicResource PencilFillIcon}" />
                    </Button>

                </StackPanel>

                <!-- Details -->
                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical" Spacing="4">

                    <!-- Start date -->
                    <TextBlock FontSize="{DynamicResource ActivitySubTextFontSize}"
                               VerticalAlignment="Center" Foreground="{DynamicResource Neutral600}">
                        <Run Text="{services:LocalizationService Key='START_DATE'}" /><Run Text=": " />
                        <Run Text="{Binding Activity.CreatedAt}" />
                    </TextBlock>

                    <!-- Target date -->
                    <TextBlock FontSize="{DynamicResource ActivitySubTextFontSize}"
                               VerticalAlignment="Center" Foreground="{DynamicResource Neutral600}">
                        <Run Text="{services:LocalizationService Key='TARGET_DATE'}" /><Run Text=": " />
                        <Run Text="{Binding Activity.TargetDate}" />
                    </TextBlock>

                </StackPanel>

                <!-- Chart -->
                <controls:MilestoneChart Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                         Value="{Binding Activity.EntriesSum}"
                                         Maximum="{Binding Activity.TargetValue}"
                                         Unit="{Binding Activity.Unit}" />

            </Grid>
        </DataTemplate>

        <!-- Template of Routine Activity -->
        <DataTemplate x:Key="RoutineActivityViewModel" x:DataType="activities:RoutineActivityViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ActivityTitleSpacing}"
                  RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource ActivityTitleSpacing}">

                <!-- Title -->
                <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Activity.Title}"
                           FontSize="{DynamicResource ActivityTitleFontSize}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Neutral700}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Interaction buttons -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            Spacing="{DynamicResource InteractionButtonsSpacing}"
                            VerticalAlignment="Center">

                    <!-- Add button -->
                    <Button Classes="icon-btn primary">
                        <PathIcon Data="{DynamicResource PlusIcon}" />
                    </Button>

                    <!-- Edit button -->
                    <Button Classes="icon-btn secondary">
                        <PathIcon Data="{DynamicResource PencilFillIcon}" />
                    </Button>

                </StackPanel>

                <!-- Calendar days -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                        BorderThickness="0,0,0,1"
                        Margin="-20,0"
                        BorderBrush="{DynamicResource Neutral300}"
                        Padding="0,20,0,10">
                    <UniformGrid Classes="calendar-days">
                        <TextBlock Text="{services:LocalizationService Key='MONDAY_SHORT'}" />
                        <TextBlock Text="{services:LocalizationService Key='TUESDAY_SHORT'}" />
                        <TextBlock Text="{services:LocalizationService Key='WEDNESDAY_SHORT'}" />
                        <TextBlock Text="{services:LocalizationService Key='THURSDAY_SHORT'}" />
                        <TextBlock Text="{services:LocalizationService Key='FRIDAY_SHORT'}" />
                        <TextBlock Text="{services:LocalizationService Key='SATURDAY_SHORT'}" />
                        <TextBlock Text="{services:LocalizationService Key='SUNDAY_SHORT'}" />
                    </UniformGrid>
                </Border>

                <!-- TODO: Calendar -->


            </Grid>
        </DataTemplate>

    </dataTemplates:TemplateSelector>

</ResourceDictionary>