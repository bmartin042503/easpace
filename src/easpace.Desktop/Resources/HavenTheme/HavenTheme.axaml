<!--
HavenTheme is a custom design system based on Avalonia's FluentTheme, using Phosphor Icons for iconography. 
It follows a three-tier token architecture: Scale tokens define raw UI values, while Semantic tokens map them to context-aware roles for Light and Dark modes. 
Component files located in the `Styles` directory apply these tokens to style individual controls.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:easpace.Desktop.Converters">

    <Styles.Resources>
        <ResourceDictionary>

            <!-- Merged Dictionaries -->
            <ResourceDictionary.MergedDictionaries>

                <!-- Scales -->
                <ResourceInclude Source="/Resources/HavenTheme/Scales/Colors.axaml" />
                <ResourceInclude Source="/Resources/HavenTheme/Scales/Border.axaml" />
                <ResourceInclude Source="/Resources/HavenTheme/Scales/Radius.axaml" />
                <ResourceInclude Source="/Resources/HavenTheme/Scales/Spacing.axaml" />
                <ResourceInclude Source="/Resources/HavenTheme/Scales/Typography.axaml" />
                <ResourceInclude Source="/Resources/HavenTheme/Scales/Sizes.axaml" />

                <!-- Phosphor Icons -->
                <ResourceInclude Source="/Resources/HavenTheme/PhosphorIcons.axaml" />
                
                <!-- Template selectors -->
                <ResourceInclude Source="/Resources/HavenTheme/TemplateSelectors/ActivityItemSelector.axaml" />
                <ResourceInclude Source="/Resources/HavenTheme/TemplateSelectors/ActivityListItemSelector.axaml" />

            </ResourceDictionary.MergedDictionaries>

            <!-- Theme Dictionaries -->
            <ResourceDictionary.ThemeDictionaries>

                <!-- Semantics -->
                <ResourceInclude x:Key="Light" Source="Semantics/Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="Semantics/Dark.axaml" />

            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>

        <!-- Poppins font -->
        <FontFamily x:Key="Poppins">avares://easpace.Desktop/Assets/Fonts#Poppins</FontFamily>

        <!-- Converters -->
        <converters:RelativeDateConverter x:Key="RelativeDateConverter" />
        <converters:RoutineStateConverter x:Key="RoutineStateConverter" />
        <converters:TimeRangeConverter x:Key="TimeRangeConverter" />

    </Styles.Resources>

    <!-- Styles -->
    <StyleInclude Source="/Resources/HavenTheme/Styles/Border.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/Button.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/GridSplitter.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/ListBox.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/ListBoxItem.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/MilestoneChart.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/Path.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/Slider.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/TextBlock.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/TextBox.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/ToggleButton.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/TrendChart.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/UniformGrid.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/PathIcon.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/NavigationListItem.axaml" />
    <StyleInclude Source="/Resources/HavenTheme/Styles/ActivityListItem.axaml" />

</Styles>