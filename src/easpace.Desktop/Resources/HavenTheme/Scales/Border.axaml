<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <x:Double x:Key="Haven.Scale.Border.Thickness.Double">1</x:Double>
    <x:Double x:Key="Haven.Scale.Border.Thickness.Double.Thick">2</x:Double>
    <x:Double x:Key="Haven.Scale.Border.Thickness.Double.Ring">40</x:Double>
    
    <Thickness x:Key="Haven.Scale.Border.Thickness">1</Thickness>
    <Thickness x:Key="Haven.Scale.Border.Thickness.Medium">1.5</Thickness>
    
    <Thickness x:Key="Haven.Scale.Border.Thickness.Right">0,0,1,0</Thickness>
    
</ResourceDictionary>
