<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <!-- To change between Dark/Light mode in the Preview, change the RequestedThemeVariant value -->
        <ThemeVariantScope RequestedThemeVariant="Light">
            <Border Padding="20" Background="{DynamicResource Haven.Sem.Canvas}">
                <StackPanel Orientation="Vertical" Spacing="20" Width="400" Height="400">

                    <CalendarDatePicker Width="200" />

                </StackPanel>
            </Border>
        </ThemeVariantScope>
    </Design.PreviewWith>

    <Style Selector="CalendarDatePicker">
        
        <Setter Property="FontFamily" Value="{StaticResource Haven.FontFamily.Poppins}" />
        <Setter Property="CornerRadius" Value="{StaticResource Haven.Scale.Radius.Xs}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Xs}" />
        <Setter Property="Padding" Value="{StaticResource Haven.Scale.Spacing.Thickness.Wide.Xxs}" />
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Surface.Elevated}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource Haven.Sem.Foreground.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
        
        <Setter Property="Theme" Value="{StaticResource Haven.ControlTheme.CalendarDatePicker}" />
        
        <Style Selector="^ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement,
                         ^ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        
        <Style Selector="^:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource Haven.Sem.Surface.Elevated}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Border}"/>
            <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
        </Style>
        
        <Style Selector="^:focus-within:not(CalendarDatePicker:focus) /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Border}"/>
            <Setter Property="BorderThickness" Value="{StaticResource Haven.Scale.Border.Thickness}" />
        </Style>
        
    </Style>
    
    <Style Selector="Calendar">
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Surface.Elevated}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="CornerRadius" Value="{StaticResource Haven.Scale.Radius.Md}" />
    </Style>
    
    <Style Selector="CalendarItem">
        <Setter Property="Theme" Value="{StaticResource Haven.ControlTheme.CalendarItem}" />
    </Style>
    
    <Style Selector="CalendarDayButton">
        <Setter Property="Theme" Value="{StaticResource Haven.ControlTheme.CalendarDayButton}" />
    </Style>
    
</Styles>
