<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:easpace.Desktop.Controls">
    <Design.PreviewWith>
        <!-- To change between Dark/Light mode in the Preview, change the RequestedThemeVariant value -->
        <ThemeVariantScope RequestedThemeVariant="Light">
            <Border Padding="20" Background="{DynamicResource Haven.Sem.Surface}" Height="600" Width="600">
                <controls:MilestoneChart Unit="pages" Value="48" Maximum="1000"/>
            </Border>
        </ThemeVariantScope>
    </Design.PreviewWith>

    <!-- MilestoneChart styling -->
    <Style Selector="controls|MilestoneChart">
        <Setter Property="TrackBrush" Value="{DynamicResource Haven.Sem.Accent.Muted}"/>
        <Setter Property="ProgressBrush" Value="{DynamicResource Haven.Sem.Accent}"/>
        <Setter Property="UnitBrush" Value="{DynamicResource Haven.Sem.Foreground.Subtle}"/>
        <Setter Property="RingThickness" Value="{StaticResource Haven.Scale.Border.Thickness.Double.Ring}"/>
        <Setter Property="Padding" Value="{StaticResource Haven.Scale.Spacing.Thickness.Md}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Xxl}" />
        <Setter Property="UnitFontSize" Value="{StaticResource Haven.Scale.FontSize.Lg}" />
    </Style>
    
</Styles>