<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="ListBox.list">
        <Setter Property="SelectionMode" Value="AlwaysSelected,Single" />
        <Setter Property="Background" Value="{StaticResource Haven.Scale.Transparent}" />
    </Style>

</Styles>