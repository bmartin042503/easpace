<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="StackPanel.wellness-panel:pointerover TextBlock.wellness-description">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="StackPanel.wellness-panel Button /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.3" Easing="SineEaseInOut" />
                <BrushTransition Property="Foreground" Duration="0:0:0.3" Easing="SineEaseInOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="StackPanel.wellness-panel:pointerover Button /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Gradient.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Accent.Strong}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.OnAccent}" />
    </Style>

    <Style Selector="StackPanel.wellness-panel:pointerover Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Haven.Sem.Gradient.Accent.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Accent.Strong}" />
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.OnAccent}" />
    </Style>

</Styles>