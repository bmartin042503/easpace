<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <!-- To change between Dark/Light mode in the Preview, change the RequestedThemeVariant value -->
        <ThemeVariantScope RequestedThemeVariant="Light">
            <Border Padding="20" Background="{DynamicResource Neutral100}">

                <StackPanel Orientation="Vertical" Spacing="20">
                    <SelectableTextBlock Classes="title" Text="Title" />
                    <SelectableTextBlock Classes="paragraph" Text="paragraph" />
                    <TextBlock Classes="activity-value" Text="Activity current value" />
                    <TextBlock Classes="activity-target" Text="Activity target value" />
                    <TextBlock Classes="calendar-day" Text="Mon" />
                    <TextBlock Classes="calendar-legend" Text="Calendar legend" />
                    <TextBlock Classes="label" Text="Label" />
                </StackPanel>
            </Border>
        </ThemeVariantScope>
    </Design.PreviewWith>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Haven.FontFamily.Poppins}" />
    </Style>
    
    <Style Selector="SelectableTextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Haven.FontFamily.Poppins}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Haven.Sem.Accent}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Haven.Sem.OnAccent}" />
    </Style>

    <Style Selector="TextBlock.title, SelectableTextBlock.title">
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Xl}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    
    <Style Selector="TextBlock.subtitle, SelectableTextBlock.subtitle">
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Lg}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.paragraph, SelectableTextBlock.paragraph">
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Md}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Md}" />
    </Style>
    
    <Style Selector="TextBlock.activity-value">
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Md}" />
    </Style>
    
    <Style Selector="TextBlock.activity-target">
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Accent}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Sm}" />
        <Setter Property="FontWeight" Value="{StaticResource Haven.Scale.FontWeight.Medium}" />
    </Style>
    
    <Style Selector="TextBlock.calendar-day">
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Sm}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    
    <Style Selector="TextBlock.calendar-legend">
        <Setter Property="Foreground" Value="{DynamicResource Haven.Sem.Foreground}" />
        <Setter Property="FontSize" Value="{StaticResource Haven.Scale.FontSize.Xs}" />
    </Style>

</Styles>