<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dataTemplates="clr-namespace:easpace.Desktop.DataTemplates"
                    xmlns:activities="clr-namespace:easpace.Desktop.ViewModels.Activities"
                    xmlns:converters="clr-namespace:easpace.Desktop.Converters">
    
    <!-- Routine state converter for RoutineActivity list item -->
    <converters:RoutineStateConverter x:Key="RoutineStateConverter" />
    
    <!-- Template selector of Activity list item -->
    <dataTemplates:ActivityViewModelTemplateSelector x:Key="ActivityListItemTemplateSelector">

        <!-- TrendActivity template -->
        <DataTemplate x:Key="TrendActivityViewModel" DataType="activities:TrendActivityViewModel">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Activity.Title}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ActivityListItemSpacing}">
                    <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center" >
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Activity.LastEntry.Value" />
                                <Binding Path="Activity.Unit" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Viewbox Grid.Column="1" Width="16" Height="16">
                        <Path Data="{StaticResource ChartLineIcon}" Classes="activity-icon" />
                    </Viewbox>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- RoutineActivity template -->
        <DataTemplate x:Key="RoutineActivityViewModel" DataType="activities:RoutineActivityViewModel">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Activity.Title}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ActivityListItemSpacing}">
                    <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                               Text="{Binding Activity.LastEntry.State, Converter={StaticResource RoutineStateConverter}}" />
                    <Viewbox Grid.Column="1" Width="16" Height="16">
                        <Path Data="{StaticResource CheckSquareOffsetIcon}" Classes="activity-icon" />
                    </Viewbox>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- MilestoneActivity template -->
        <DataTemplate x:Key="MilestoneActivityViewModel" DataType="activities:MilestoneActivityViewModel">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Activity.Title}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ActivityListItemSpacing}">
                    <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1} {2}">
                                <Binding Path="Activity.EntriesSum" />
                                <Binding Path="Activity.TargetValue" />
                                <Binding Path="Activity.Unit" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Viewbox Grid.Column="1" Width="16" Height="16">
                        <Path Data="{StaticResource ChartPieSliceIcon}" Classes="activity-icon" />
                    </Viewbox>
                </Grid>
            </Grid>
        </DataTemplate>

    </dataTemplates:ActivityViewModelTemplateSelector>
</ResourceDictionary>
