<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    
    <!-- Thickness of sidebar -->
    <Thickness x:Key="SidebarBorderThickness">0,0,1,0</Thickness>

    <!-- Thickness of Button borders -->
    <Thickness x:Key="ButtonBorderThickness">1</Thickness>
    
    <!-- Thickness of card Border -->
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    
    <!-- Thickness of MilestoneChart's ring -->
    <system:Double x:Key="MilestoneChartRingThickness">34</system:Double>
    
    <!-- Thickness of CalendarDay -->
    <system:Double x:Key="CalendarDayBorderThickness">1.5</system:Double>

</ResourceDictionary>