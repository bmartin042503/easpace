<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Corner radius of ListBoxItems -->
    <CornerRadius x:Key="ListBoxItemCornerRadius">10</CornerRadius>
    
    <!-- Corner radius of Buttons -->
    <CornerRadius x:Key="LabeledButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="IconButtonCornerRadius">32</CornerRadius>
    
    <!-- Corner radius of card Border -->
    <CornerRadius x:Key="CardCornerRadius">20</CornerRadius>
    
    <!-- Corner radius of TrendChart segmented control -->
    <CornerRadius x:Key="ChartSegmentedControlCornerRadius">8</CornerRadius>
    
    <!-- Corner radius of TrendChart segmented control item -->
    <CornerRadius x:Key="ChartSegmentedControlItemCornerRadius">6</CornerRadius>
    
</ResourceDictionary>
