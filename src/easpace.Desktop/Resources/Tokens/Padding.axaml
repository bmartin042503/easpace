<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Padding of Buttons -->
    <Thickness x:Key="LabeledButtonPadding">10,4</Thickness>
    <Thickness x:Key="IconButtonPadding">0</Thickness>

    <!-- Padding of ListBoxItems -->
    <Thickness x:Key="ListBoxItemPadding">14,12</Thickness>

    <!-- Padding of card Border -->
    <Thickness x:Key="CardPadding">20</Thickness>
    
    <!-- Padding of TrendChart segmented control -->
    <Thickness x:Key="TrendChartSegmentedControlPadding">4</Thickness>
    
    <!-- Padding of TrendChart segmented control item -->
    <Thickness x:Key="TrendChartSegmentedControlItemPadding">12,4</Thickness>
    
    <!-- Padding of MilestoneChart -->
    <Thickness x:Key="MilestoneChartPadding">64</Thickness>
    
</ResourceDictionary>
