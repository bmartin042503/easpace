<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:easpace.Desktop.ViewModels"
             xmlns:services="clr-namespace:easpace.Desktop.Services"
             xmlns:datatemplates="clr-namespace:easpace.Desktop.DataTemplates"
             xmlns:activities="clr-namespace:easpace.Desktop.ViewModels.Activities"
             xmlns:converters="clr-namespace:easpace.Desktop.Converters"
             xmlns:controls="clr-namespace:easpace.Desktop.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ActivitiesViewModel"
             x:Class="easpace.Desktop.Views.ActivitiesView"
             Background="{DynamicResource Haven.Sem.Canvas}">

    <Design.DataContext>
        <vm:ActivitiesViewModel />
    </Design.DataContext>

    <UserControl.Resources>

        <!-- Routine state converter for RoutineActivity list item -->
        <converters:RoutineStateConverter x:Key="RoutineStateConverter" />

        <!-- TimeRange converter for Chart segmented control-->
        <converters:TimeRangeConverter x:Key="TimeRangeConverter" />

        <!-- Template selector of Activity list item -->
        <datatemplates:TemplateSelector x:Key="ActivityListItemTemplateSelector">

            <!-- Template of Trend Activity -->
            <DataTemplate x:Key="TrendActivityViewModel" DataType="activities:TrendActivityViewModel">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Activity.Title}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                          ColumnSpacing="{DynamicResource ActivityListItemSpacing}">
                        <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding Activity.LastEntry.Value}" />
                        <Viewbox Grid.Column="1" Width="16" Height="16">
                            <Path Data="{StaticResource ChartLineIcon}" Classes="activity-icon" />
                        </Viewbox>
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- Template of Routine Activity -->
            <DataTemplate x:Key="RoutineActivityViewModel" DataType="activities:RoutineActivityViewModel">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Activity.Title}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                          ColumnSpacing="{DynamicResource ActivityListItemSpacing}">
                        <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding Activity.LastEntry.State, Converter={StaticResource RoutineStateConverter}}" />
                        <Viewbox Grid.Column="1" Width="16" Height="16">
                            <Path Data="{StaticResource CheckSquareOffsetIcon}" Classes="activity-icon" />
                        </Viewbox>
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- Template of Milestone Activity -->
            <DataTemplate x:Key="MilestoneActivityViewModel" DataType="activities:MilestoneActivityViewModel">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Activity.Title}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                          ColumnSpacing="{DynamicResource ActivityListItemSpacing}">
                        <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}/{1}">
                                    <Binding Path="Activity.EntriesSum" />
                                    <Binding Path="Activity.TargetValue" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Viewbox Grid.Column="1" Width="16" Height="16">
                            <Path Data="{StaticResource ChartPieSliceIcon}" Classes="activity-icon" />
                        </Viewbox>
                    </Grid>
                </Grid>
            </DataTemplate>

        </datatemplates:TemplateSelector>

        <!-- Template selector of Activity view -->
        <datatemplates:TemplateSelector x:Key="ActivityViewTemplateSelector">

            <!-- Template of Trend Activity -->
            <DataTemplate x:Key="TrendActivityViewModel" x:DataType="activities:TrendActivityViewModel">
                <Border Classes="card primary">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ActivityTitleSpacing}"
                          RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource ActivityTitleSpacing}">

                        <!-- Title -->
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Activity.Title}"
                                   FontSize="{DynamicResource ActivityTitleFontSize}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Neutral700}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Interaction buttons -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                    Spacing="{DynamicResource InteractionButtonsSpacing}"
                                    VerticalAlignment="Center">

                            <!-- Add button -->
                            <Button Classes="icon-btn primary">
                                <PathIcon Data="{DynamicResource PlusIcon}" />
                            </Button>

                            <!-- Edit button -->
                            <Button Classes="icon-btn secondary">
                                <PathIcon Data="{DynamicResource PencilFillIcon}" />
                            </Button>

                        </StackPanel>

                        <!-- Details -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Spacing="12">

                            <!-- Current value -->
                            <TextBlock FontSize="{DynamicResource ActivityTextFontSize}"
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="Activity.LastEntry.Value" />
                                        <Binding Path="Activity.Unit" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <!-- Target value -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Foreground="{DynamicResource Primary600}"
                                           FontSize="16"
                                           FontWeight="Medium" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="Activity.TargetValue" />
                                            <Binding Path="Activity.Unit" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <PathIcon
                                    Width="18" Height="18"
                                    Data="{DynamicResource TargetIcon}"
                                    Foreground="{DynamicResource Primary600}"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                        </StackPanel>

                        <!-- Time Range Selection (segmented control) -->
                        <ListBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Classes="chart-segmented-control"
                                 HorizontalAlignment="Left" Margin="0,10,0,0"
                                 ItemsSource="{Binding TimeRanges}"
                                 SelectedItem="{Binding SelectedTimeRange}">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TimeRangeConverter}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                        <!-- Chart -->
                        <controls:TrendChart Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                             Target="{Binding Activity.TargetValue}"
                                             Unit="{Binding Activity.Unit}"
                                             Entries="{Binding ChartEntries}"
                                             Margin="0,20,0,0" />

                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Template of Milestone Activity -->
            <DataTemplate x:Key="MilestoneActivityViewModel" x:DataType="activities:MilestoneActivityViewModel">
                <Border Classes="card primary">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ActivityTitleSpacing}"
                          RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource ActivityTitleSpacing}">

                        <!-- Title -->
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Activity.Title}"
                                   FontSize="{DynamicResource ActivityTitleFontSize}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Neutral700}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Interaction buttons -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                    Spacing="{DynamicResource InteractionButtonsSpacing}"
                                    VerticalAlignment="Center">

                            <!-- Add button -->
                            <Button Classes="icon-btn primary">
                                <PathIcon Data="{DynamicResource PlusIcon}" />
                            </Button>

                            <!-- Edit button -->
                            <Button Classes="icon-btn secondary">
                                <PathIcon Data="{DynamicResource PencilFillIcon}" />
                            </Button>

                        </StackPanel>

                        <!-- Details -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical" Spacing="4">

                            <!-- Start date -->
                            <TextBlock FontSize="{DynamicResource ActivitySubTextFontSize}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Neutral600}">
                                <Run Text="{services:LocalizationService Key='START_DATE'}" /><Run Text=": " />
                                <Run Text="{Binding Activity.CreatedAt}" />
                            </TextBlock>

                            <!-- Target date -->
                            <TextBlock FontSize="{DynamicResource ActivitySubTextFontSize}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Neutral600}">
                                <Run Text="{services:LocalizationService Key='TARGET_DATE'}" /><Run Text=": " />
                                <Run Text="{Binding Activity.TargetDate}" />
                            </TextBlock>

                        </StackPanel>

                        <!-- Chart -->
                        <controls:MilestoneChart Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                 Value="{Binding Activity.EntriesSum}"
                                                 Maximum="{Binding Activity.TargetValue}"
                                                 Unit="{Binding Activity.Unit}" />

                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Template of Routine Activity -->
            <DataTemplate x:Key="RoutineActivityViewModel" x:DataType="activities:RoutineActivityViewModel">
                <Border Classes="card primary">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource ActivityTitleSpacing}"
                          RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource ActivityTitleSpacing}">

                        <!-- Title -->
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Activity.Title}"
                                   FontSize="{DynamicResource ActivityTitleFontSize}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Neutral700}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Interaction buttons -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                    Spacing="{DynamicResource InteractionButtonsSpacing}"
                                    VerticalAlignment="Center">

                            <!-- Add button -->
                            <Button Classes="icon-btn primary">
                                <PathIcon Data="{DynamicResource PlusIcon}" />
                            </Button>

                            <!-- Edit button -->
                            <Button Classes="icon-btn secondary">
                                <PathIcon Data="{DynamicResource PencilFillIcon}" />
                            </Button>

                        </StackPanel>

                        <!-- Calendar days -->
                        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                BorderThickness="0,0,0,1"
                                Margin="-20,0"
                                BorderBrush="{DynamicResource Neutral300}"
                                Padding="0,20,0,10">
                            <UniformGrid Classes="calendar-days">
                                <TextBlock Text="{services:LocalizationService Key='MONDAY_SHORT'}" />
                                <TextBlock Text="{services:LocalizationService Key='TUESDAY_SHORT'}" />
                                <TextBlock Text="{services:LocalizationService Key='WEDNESDAY_SHORT'}" />
                                <TextBlock Text="{services:LocalizationService Key='THURSDAY_SHORT'}" />
                                <TextBlock Text="{services:LocalizationService Key='FRIDAY_SHORT'}" />
                                <TextBlock Text="{services:LocalizationService Key='SATURDAY_SHORT'}" />
                                <TextBlock Text="{services:LocalizationService Key='SUNDAY_SHORT'}" />
                            </UniformGrid>
                        </Border>

                        <!-- TODO: Calendar -->


                    </Grid>
                </Border>
            </DataTemplate>

        </datatemplates:TemplateSelector>

    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="1*,3*" Margin="{DynamicResource PageContentMargin}"
          ColumnSpacing="{DynamicResource PageContentSpacing}">

        <!-- Main title -->
        <TextBlock Grid.Column="0" Grid.Row="0"
                   Text="{services:LocalizationService Key='ACTIVITIES_TITLE'}"
                   Classes="pageTitle" />

        <!-- Subtitle -->
        <TextBlock Grid.Column="0" Grid.Row="1"
                   Text="{services:LocalizationService Key='ACTIVITIES_SUBTITLE'}"
                   Classes="pageSubTitle" />

        <Grid Grid.Column="0" Grid.Row="2" RowDefinitions="Auto,*" Margin="0,30,0,0">
            <Button Grid.Row="0" Classes="labeled-btn primary" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="{DynamicResource LabeledButtonColumnSpacing}">
                    <TextBlock Grid.Column="0"
                               FontSize="{DynamicResource LabeledButtonFontSize}"
                               Text="{services:LocalizationService Key='ADD_NEW'}" />
                    <PathIcon Grid.Column="1" Data="{DynamicResource PlusIcon}" />
                </Grid>
            </Button>

            <ListBox Grid.Row="1" Classes="activities-list"
                     Margin="0,20,0,0"
                     ItemsSource="{Binding ActivityViewModels}"
                     SelectedItem="{Binding SelectedActivityViewModel}">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="activities:ActivityViewModel">
                        <ContentControl Content="{Binding .}"
                                        ContentTemplate="{StaticResource ActivityListItemTemplateSelector}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>

        <ContentControl Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                        Content="{Binding SelectedActivityViewModel}"
                        ContentTemplate="{DynamicResource ActivityViewTemplateSelector}" />

    </Grid>
</UserControl>