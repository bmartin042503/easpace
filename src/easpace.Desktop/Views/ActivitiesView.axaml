<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:easpace.Desktop.ViewModels"
             xmlns:services="clr-namespace:easpace.Desktop.Services"
             xmlns:vma="clr-namespace:easpace.Desktop.ViewModels.Activities"
             xmlns:dataTemplates="clr-namespace:easpace.Desktop.DataTemplates"
             xmlns:controls="clr-namespace:easpace.Desktop.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ActivitiesViewModel"
             x:Class="easpace.Desktop.Views.ActivitiesView"
             Background="{DynamicResource Haven.Sem.Canvas}">

    <Design.DataContext>
        <vm:ActivitiesViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <!-- Template selector of Activity list item -->
        <dataTemplates:TemplateSelector x:Key="ActivityListItemSelector">

            <!-- Template of Trend Activity -->
            <DataTemplate x:Key="TrendActivityViewModel" DataType="vma:TrendActivityViewModel">
                <controls:ActivityListItem Title="{Binding Activity.Name}"
                                           Status="{Binding Activity.LastEntry.Value}"
                                           Icon="{StaticResource Haven.PhosphorIcons.ChartLine}"
                                           SelectedIcon="{StaticResource Haven.PhosphorIcons.ChartLine.Fill}" />
            </DataTemplate>

            <!-- Template of Routine Activity -->
            <DataTemplate x:Key="RoutineActivityViewModel" DataType="vma:RoutineActivityViewModel">
                <controls:ActivityListItem Title="{Binding Activity.Name}"
                                           Status="{Binding Activity.TodayEntry.State, Converter={StaticResource EnumToLocalizedConverter}}"
                                           Icon="{StaticResource Haven.PhosphorIcons.CheckSquareOffset}"
                                           SelectedIcon="{StaticResource Haven.PhosphorIcons.CheckSquareOffset.Fill}" />
            </DataTemplate>

            <!-- Template of Milestone Activity -->
            <DataTemplate x:Key="MilestoneActivityViewModel" DataType="vma:MilestoneActivityViewModel">
                <controls:ActivityListItem Title="{Binding Activity.Name}"
                                           Icon="{StaticResource Haven.PhosphorIcons.ChartPieSlice}"
                                           SelectedIcon="{StaticResource Haven.PhosphorIcons.ChartPieSlice.Fill}">
                    <controls:ActivityListItem.Status>
                        <MultiBinding StringFormat="{}{0}/{1}">
                            <Binding Path="Activity.EntriesSum" />
                            <Binding Path="Activity.Target" />
                        </MultiBinding>
                    </controls:ActivityListItem.Status>
                </controls:ActivityListItem>
            </DataTemplate>

        </dataTemplates:TemplateSelector>
    </UserControl.Resources>

    <Border Classes="card" Margin="{StaticResource Haven.Scale.Spacing.Thickness.Lg}">

        <Grid ColumnSpacing="{StaticResource Haven.Scale.Spacing.Xs}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" MaxWidth="600" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid RowDefinitions="Auto,*" Grid.Column="0" RowSpacing="{StaticResource Haven.Scale.Spacing.Xl}">

                <!-- Top bar -->
                <StackPanel Grid.Row="0" Orientation="Vertical">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Haven.Scale.Spacing.Sm}">

                        <!-- Search box -->
                        <TextBox Grid.Column="0"
                                 PlaceholderText="{services:LocalizationService Key='Activities.Search.Placeholder'}"
                                 MinWidth="140">
                            <TextBox.InnerRightContent>
                                <PathIcon Data="{StaticResource Haven.PhosphorIcons.MagnifyingGlass}" />
                            </TextBox.InnerRightContent>
                        </TextBox>

                        <!-- Add button -->
                        <Button Grid.Column="1" Classes="primary icon" HorizontalAlignment="Left"
                                Command="{Binding AddActivityCommand}"
                                ToolTip.Tip="{services:LocalizationService Key='Common.Button.Add'}"
                                IsEnabled="{Binding !IsEditing}">
                            <PathIcon Data="{StaticResource Haven.PhosphorIcons.Plus.Bold}" />
                        </Button>

                    </Grid>

                </StackPanel>

                <!-- No entries view -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="{StaticResource Haven.Scale.Spacing.Sm}"
                            IsVisible="{Binding !HasActivities}">

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Haven.Scale.Spacing.Sm}"
                                HorizontalAlignment="Center">

                        <!-- Chart line icon -->
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.ChartLine}"
                                  Width="{StaticResource Haven.Scale.Icon.Size.Md}"
                                  Height="{StaticResource Haven.Scale.Icon.Size.Md}"
                                  Foreground="{DynamicResource Haven.Sem.Foreground.Subtle}"
                                  RenderTransformOrigin="50%,50%"
                                  Margin="0,6,0,0">

                            <PathIcon.RenderTransform>
                                <RotateTransform Angle="-10" />
                            </PathIcon.RenderTransform>

                        </PathIcon>

                        <!-- Chart pie slice icon -->
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.ChartPieSlice}"
                                  Width="{StaticResource Haven.Scale.Icon.Size.Xl}"
                                  Height="{StaticResource Haven.Scale.Icon.Size.Xl}"
                                  Foreground="{DynamicResource Haven.Sem.Foreground.Subtle}" />

                        <!-- Check square offset icon -->
                        <PathIcon Data="{StaticResource Haven.PhosphorIcons.CheckSquareOffset}"
                                  Width="{StaticResource Haven.Scale.Icon.Size.Md}"
                                  Height="{StaticResource Haven.Scale.Icon.Size.Md}"
                                  Foreground="{DynamicResource Haven.Sem.Foreground.Subtle}"
                                  RenderTransformOrigin="50%,50%"
                                  Margin="0,6,0,0">

                            <PathIcon.RenderTransform>
                                <RotateTransform Angle="10" />
                            </PathIcon.RenderTransform>

                        </PathIcon>

                    </StackPanel>

                    <!-- 'Add entries' message -->
                    <TextBlock Text="{services:LocalizationService Key='Activities.Empty.Message'}"
                               Foreground="{DynamicResource Haven.Sem.Foreground.Subtle}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Activity entries list -->
                <ScrollViewer Grid.Row="1">
                    <ListBox Classes="activity list"
                             ItemsSource="{Binding ActivityViewModels}"
                             SelectedItem="{Binding SelectedActivityViewModel}">

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vma:ActivityViewModel">
                                <ContentControl Content="{Binding .}"
                                                ContentTemplate="{StaticResource ActivityListItemSelector}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="{StaticResource Haven.Scale.Spacing.Sm}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                    </ListBox>
                </ScrollViewer>

            </Grid>

            <!-- Horizontal splitter -->
            <GridSplitter Grid.Column="1"
                          Classes="horizontal"
                          ResizeDirection="Columns" />

            <!-- Activity item view -->
            <ContentControl Grid.Row="0" Grid.Column="2"
                            Content="{Binding ContentViewModel}" />

        </Grid>

    </Border>

</UserControl>