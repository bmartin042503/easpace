<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:easpace.Desktop.ViewModels"
             xmlns:controls="clr-namespace:easpace.Desktop.Controls"
             xmlns:core="clr-namespace:easpace.Desktop.Services.Core"
             xmlns:dataTemplates="clr-namespace:easpace.Desktop.DataTemplates"
             xmlns:constants="clr-namespace:easpace.Desktop.Constants"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="easpace.Desktop.Views.OnboardingPageView"
             x:DataType="vm:OnboardingPageViewModel"
             Background="{DynamicResource Sem.Background.Blobs}"
             Padding="{OnPlatform Windows='0,12,0,0', Linux='0,12,0,0'}">

    <UserControl.Resources>

        <dataTemplates:TemplateSelector x:Key="OnboardingContentSelector">

            <!-- Welcome - view -->
            <DataTemplate x:Key="Welcome" x:DataType="constants:OnboardingContent">

                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="128"
                      VerticalAlignment="Center" HorizontalAlignment="Center">

                    <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Spacing="4">

                        <!-- App logo -->
                        <PathIcon Height="90" Width="90"
                                  Margin="{StaticResource Metrics.Spacing.Thickness.Lg}"
                                  HorizontalAlignment="Center"
                                  Data="{StaticResource AppIcons.Easpace.V2}"
                                  Foreground="{DynamicResource Sem.Brand}" />

                        <!-- easpace title -->
                        <TextBlock Classes="strong brand fs1" Text="easpace"
                                   HorizontalAlignment="Center" />

                        <!-- subtitle -->
                        <TextBlock Classes="brand fs4"
                                   Text="{core:LocalizationService Key='Onboarding.Welcome.Subtitle'}"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                    <!-- Continue button -->
                    <Button Classes="primary regular" Grid.Row="2"
                            Content="{core:LocalizationService Key='Onboarding.Welcome.GetStarted'}"
                            HorizontalAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).ContinueCommand}" />

                </Grid>

            </DataTemplate>

            <!-- Terms of Use - view -->
            <DataTemplate x:Key="TermsOfUse" x:DataType="constants:OnboardingContent">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Metrics.Spacing.Xs}"
                      RowDefinitions="Auto,*,Auto,Auto" RowSpacing="{StaticResource Metrics.Spacing.Xxl}"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Margin="{StaticResource Metrics.Spacing.Thickness.Lg}">

                    <!-- Navigate back button -->
                    <Button Grid.Row="0" Grid.Column="0" Classes="primary icon"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).NavigateBackCommand}"
                            ToolTip.Tip="{core:LocalizationService Key='Common.Button.Back'}">
                        <PathIcon Data="{StaticResource PhosphorIcons.ArrowLeft.Bold}" />
                    </Button>

                    <!-- Title -->
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Classes="strong brand fs1"
                               Text="{core:LocalizationService Key='Credits.Text.TermsOfUse'}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <!-- Legal content -->
                    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Classes="elevated card" MaxWidth="900"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ScrollViewer>
                            <SelectableTextBlock Classes="neutral fs4 trm-ellipsis"
                                                 Text="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).LegalContent}"
                                                 VerticalAlignment="Center" HorizontalAlignment="Left"
                                                 TextWrapping="Wrap" TextAlignment="Left" />
                        </ScrollViewer>
                    </Border>

                    <!-- Accept terms of use checkbox -->
                    <CheckBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                              Content="{core:LocalizationService Key='Onboarding.TermsOfUse.Accept'}"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              IsChecked="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).IsTermsOfUseAccepted}" />

                    <!-- Continue button -->
                    <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Classes="primary regular"
                            Content="{core:LocalizationService Key='Common.Button.Continue'}"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).IsTermsOfUseAccepted}"
                            Command="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).ContinueCommand}" />

                </Grid>

            </DataTemplate>

            <!-- Privacy Policy - view -->
            <DataTemplate x:Key="PrivacyPolicy" x:DataType="constants:OnboardingContent">

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*,Auto"
                      ColumnSpacing="{StaticResource Metrics.Spacing.Xs}"
                      RowSpacing="{StaticResource Metrics.Spacing.Xxl}"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Margin="{StaticResource Metrics.Spacing.Thickness.Lg}">

                    <!-- Navigate back button -->
                    <Button Grid.Row="0" Grid.Column="0" Classes="primary icon"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).NavigateBackCommand}"
                            ToolTip.Tip="{core:LocalizationService Key='Common.Button.Back'}">
                        <PathIcon Data="{StaticResource PhosphorIcons.ArrowLeft.Bold}" />
                    </Button>

                    <!-- Title -->
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                               Classes="strong brand fs1 trm-ellipsis"
                               Text="{core:LocalizationService Key='Credits.Text.PrivacyPolicy'}"
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <!-- Legal content -->
                    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Classes="elevated card" MaxWidth="900"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ScrollViewer>
                            <SelectableTextBlock Classes="neutral fs4 trm-ellipsis"
                                                 Text="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).LegalContent}"
                                                 VerticalAlignment="Center" HorizontalAlignment="Left"
                                                 TextWrapping="Wrap" TextAlignment="Left" />
                        </ScrollViewer>
                    </Border>

                    <!-- Continue button -->
                    <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Classes="primary regular"
                            Content="{core:LocalizationService Key='Common.Button.Continue'}"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).IsTermsOfUseAccepted}"
                            Command="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).ContinueCommand}" />

                </Grid>

            </DataTemplate>

            <!-- Customize - view -->
            <DataTemplate x:Key="Customize" x:DataType="constants:OnboardingContent">

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*,Auto,Auto"
                      ColumnSpacing="{StaticResource Metrics.Spacing.Xl}"
                      RowSpacing="{StaticResource Metrics.Spacing.Xxl}"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Margin="{StaticResource Metrics.Spacing.Thickness.Lg}">

                    <!-- Navigate back button -->
                    <Button Grid.Row="0" Grid.Column="0" Classes="primary icon"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).NavigateBackCommand}"
                            ToolTip.Tip="{core:LocalizationService Key='Common.Button.Back'}">
                        <PathIcon Data="{StaticResource PhosphorIcons.ArrowLeft.Bold}" />
                    </Button>

                    <!-- Title -->
                    <TextBlock Grid.Column="1" Grid.Row="0"
                               Classes="strong brand fs1 trm-ellipsis"
                               Text="{core:LocalizationService Key='Onboarding.Customize.Title'}"
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <!-- Customization -->
                    <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                          RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          RowSpacing="{StaticResource Metrics.Spacing.Lg}"
                          ColumnSpacing="{StaticResource Metrics.Spacing.Lg}">

                        <!-- Appearance label -->
                        <TextBlock Grid.Column="0" Grid.Row="0" Classes="neutral fs4 trm-ellipsis"
                                   Text="{core:LocalizationService Key='Onboarding.Customize.Appearance'}"
                                   VerticalAlignment="Center" />

                        <!-- Appearance combo box -->
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Width="{StaticResource Metrics.Input.Setting.MinWidth}"
                                  SelectedIndex="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).SelectedColorSchemeAppearanceIndex}">
                            <ComboBoxItem
                                Content="{core:LocalizationService Key='Settings.ColorSchemeAppearanceSetting.System'}" />
                            <ComboBoxItem
                                Content="{core:LocalizationService Key='Settings.ColorSchemeAppearanceSetting.Light'}" />
                            <ComboBoxItem
                                Content="{core:LocalizationService Key='Settings.ColorSchemeAppearanceSetting.Dark'}" />
                        </ComboBox>

                        <!-- Color palette label -->
                        <TextBlock Grid.Column="0" Grid.Row="1" Classes="neutral fs4 trm-ellipsis"
                                   Text="{core:LocalizationService Key='Onboarding.Customize.ColorPalette'}"
                                   VerticalAlignment="Center" />

                        <!-- Color scheme combo box -->
                        <ComboBox Grid.Column="1" Grid.Row="1"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Width="{StaticResource Metrics.Input.Setting.MinWidth}"
                                  SelectedIndex="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).SelectedColorSchemeIndex}">
                            <ComboBoxItem
                                Content="{core:LocalizationService Key='Settings.ColorScheme.HavenBlue'}" />
                            <ComboBoxItem
                                Content="{core:LocalizationService Key='Settings.ColorScheme.AvallamaPurple'}" />
                        </ComboBox>
                        
                        <!-- Translucency label -->
                        <TextBlock Grid.Column="0" Grid.Row="2" Classes="neutral fs4 trm-ellipsis"
                                   Text="{core:LocalizationService Key='Onboarding.Customize.Translucency'}"
                                   VerticalAlignment="Center" />
                        
                        <!-- Translucency toggle switch -->
                        <ToggleSwitch Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                      IsChecked="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).IsTranslucencyEnabled}" />

                    </Grid>

                    <!-- Description -->
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                               Classes="subtle neutral fs5 trm-ellipsis"
                               Text="{core:LocalizationService Key='Onboarding.Customize.Description'}"
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <!-- Continue button -->
                    <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Classes="primary regular"
                            Content="{core:LocalizationService Key='Common.Button.Continue'}"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).IsTermsOfUseAccepted}"
                            Command="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).ContinueCommand}" />

                </Grid>

            </DataTemplate>

            <!-- Beta software warning - view -->
            <DataTemplate x:Key="BetaSoftwareWarning" x:DataType="constants:OnboardingContent">

                <Grid RowDefinitions="*,Auto,Auto,Auto,Auto"
                      ColumnSpacing="{StaticResource Metrics.Spacing.Xs}"
                      RowSpacing="{StaticResource Metrics.Spacing.Xxl}"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Margin="{StaticResource Metrics.Spacing.Thickness.Xxl}">

                    <!-- Navigate back button -->
                    <Button Grid.Row="0" Classes="primary icon"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).NavigateBackCommand}"
                            ToolTip.Tip="{core:LocalizationService Key='Common.Button.Back'}">
                        <PathIcon Data="{StaticResource PhosphorIcons.ArrowLeft.Bold}" />
                    </Button>

                    <!-- Title -->
                    <TextBlock Grid.Row="1"
                               Classes="strong danger fs2 medium trm-ellipsis"
                               Text="{core:LocalizationService Key='Onboarding.BetaWarning.Title'}"
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <!-- Description -->
                    <TextBlock Grid.Row="2" MaxWidth="640"
                               Classes="danger fs4 trm-ellipsis"
                               Text="{core:LocalizationService Key='Onboarding.BetaWarning.Description'}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <!-- Accept beta software warning checkbox -->
                    <CheckBox Grid.Row="3" Content="{core:LocalizationService Key='Onboarding.BetaWarning.Accept'}"
                              VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600"
                              HorizontalContentAlignment="Center"
                              IsChecked="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).IsBetaSoftwareWarningAccepted}" />

                    <!-- Continue button -->
                    <Button Grid.Row="4" Classes="primary regular"
                            Content="{core:LocalizationService Key='Common.Button.Continue'}"
                            HorizontalAlignment="Center"
                            IsEnabled="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).IsBetaSoftwareWarningAccepted}"
                            Command="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).ContinueCommand}" />

                </Grid>

            </DataTemplate>

            <!-- Thank you - view -->
            <DataTemplate x:Key="ThankYou" x:DataType="constants:OnboardingContent">

                <Grid RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="{StaticResource Metrics.Spacing.Xs}"
                      RowSpacing="80"
                      VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Classes="strong brand fs2 medium trm-ellipsis" MaxWidth="800"
                               Text="{core:LocalizationService Key='Onboarding.ThankYou.Title'}" TextAlignment="Center"
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="2">

                        <TextBlock Classes="brand fs4 trm-ellipsis"
                                   Text="{core:LocalizationService Key='Onboarding.Text.DeveloperNameAndContact'}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Classes="neutral fs5 trm-ellipsis"
                                   Text="{core:LocalizationService Key='Onboarding.Text.Developer'}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right" />

                    </StackPanel>


                    <!-- Continue button -->
                    <Button Grid.Row="2" Classes="primary regular"
                            Content="{core:LocalizationService Key='Common.Button.Continue'}"
                            HorizontalAlignment="Center"
                            Command="{Binding $parent[UserControl].((vm:OnboardingPageViewModel)DataContext).ContinueCommand}" />

                </Grid>

            </DataTemplate>

        </dataTemplates:TemplateSelector>

    </UserControl.Resources>

    <!-- Page content -->
    <Grid>

        <!-- Blobs gradient background -->
        <controls:BlobsGradientBackground
            BackgroundBrush="Transparent"
            FromBrush="{DynamicResource Sem.Brand.Subtle}"
            ToBrush="{DynamicResource Sem.Brand.Strong}"
            EllipseCount="7"
            Speed="0.25"
            Opacity="0.25" />

        <!-- Transitioning onboarding content -->
        <TransitioningContentControl HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Content="{Binding CurrentContent}"
                                     ContentTemplate="{StaticResource OnboardingContentSelector}">

            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:00:00.3" />
            </TransitioningContentControl.PageTransition>

        </TransitioningContentControl>

        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.5"
                   Classes="brand fs5" Margin="{StaticResource Metrics.Spacing.Thickness.Xxs}"
                   Text="{Binding VersionText}" />

    </Grid>

</UserControl>