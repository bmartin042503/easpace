<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:easpace.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:easpace.Desktop.Controls"
        xmlns:services="clr-namespace:easpace.Desktop.Services"
        xmlns:templatedControls="clr-namespace:easpace.Desktop.Resources.HavenTheme.TemplatedControls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="easpace.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        WindowStartupLocation="CenterScreen"
        Title="easpace"
        MinHeight="450"
        MinWidth="700">

    <Grid ColumnDefinitions="Auto,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Classes="sidebar">

            <ListBox Classes="nav list" SelectedIndex="{Binding SelectedNavIndex}">

                <ListBoxItem Grid.Row="0">
                    <templatedControls:NavigationListItem Icon="{StaticResource Haven.PhosphorIcons.Notebook}"
                                                 SelectedIcon="{StaticResource Haven.PhosphorIcons.Notebook.Fill}"
                                                 Text="{services:LocalizationService Key='Navigation.Item.Journal'}" />
                </ListBoxItem>

                <ListBoxItem Grid.Row="1">
                    <templatedControls:NavigationListItem Icon="{StaticResource Haven.PhosphorIcons.Target}"
                                                          SelectedIcon="{StaticResource Haven.PhosphorIcons.Target.Fill}"
                                                          Text="{services:LocalizationService Key='Navigation.Item.Activities'}" />
                </ListBoxItem>

                <ListBoxItem Grid.Row="2">
                    <templatedControls:NavigationListItem Icon="{StaticResource Haven.PhosphorIcons.Brain}"
                                                          SelectedIcon="{StaticResource Haven.PhosphorIcons.Brain.Fill}"
                                                          Text="{services:LocalizationService Key='Navigation.Item.Mood'}" />
                </ListBoxItem>

                <ListBoxItem Grid.Row="3">
                    <templatedControls:NavigationListItem Icon="{StaticResource Haven.PhosphorIcons.FlowerLotus}"
                                                          SelectedIcon="{StaticResource Haven.PhosphorIcons.FlowerLotus.Fill}"
                                                          Text="{services:LocalizationService Key='Navigation.Item.Wellness'}" />
                </ListBoxItem>

                <ListBoxItem Grid.Row="5">
                    <templatedControls:NavigationListItem Icon="{StaticResource Haven.PhosphorIcons.Gear}"
                                                          SelectedIcon="{StaticResource Haven.PhosphorIcons.Gear.Fill}"
                                                          Text="{services:LocalizationService Key='Navigation.Item.Settings'}" />
                </ListBoxItem>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                              RowSpacing="{StaticResource Haven.Scale.Spacing.Xs}"
                              IsVisible="{Binding IsSidebarVisible}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

            </ListBox>

        </Border>

        <!-- Selected page content -->
        <ContentControl Grid.Column="1"
                        x:Name="PageContent"
                        Content="{Binding CurrentPageViewModel}" />

        <!-- Dialog host -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              IsVisible="{Binding CurrentDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Background="{StaticResource Haven.Scale.Black}" Opacity="0.15" />
            <ContentControl x:Name="DialogHost" Content="{Binding CurrentDialog}"
                            PointerPressed="DialogHost_PointerPressed"
                            PointerMoved="DialogHost_PointerMoved"
                            PointerReleased="DialogHost_PointerReleased"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl.RenderTransform>
                    <TranslateTransform />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

    </Grid>

</Window>