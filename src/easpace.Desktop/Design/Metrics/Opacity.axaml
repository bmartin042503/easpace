<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Default opacity values that can be changed via TranslucencyService -->
    <x:Double x:Key="Opacity.Page">1.0</x:Double>
    <x:Double x:Key="Opacity.Sidebar">1.0</x:Double>
    <x:Double x:Key="Opacity.Card">1.0</x:Double>
    
</ResourceDictionary>