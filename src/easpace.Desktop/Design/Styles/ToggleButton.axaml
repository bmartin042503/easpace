<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="using:easpace.Desktop.Design">
    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource Sem.Surface}"
                design:PreviewScheme.Variant="HavenBlue.Dark">
            <Border Classes="card secondary" Padding="20">
                <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12" MaxWidth="200">

                    <ToggleButton IsChecked="False"
                                  Classes="mood-label">
                        <TextBlock Text="Happiness" />
                    </ToggleButton>

                    <ToggleButton IsChecked="False"
                                  Classes="mood-label">
                        <TextBlock Text="Hope" />
                    </ToggleButton>

                    <ToggleButton IsChecked="True"
                                  Classes="mood-label">
                        <TextBlock Text="Calm" />
                    </ToggleButton>

                </WrapPanel>
            </Border>
        </Border>
    </Design.PreviewWith>

    <!-- Mood label toggle button styling -->
    <Style Selector="ToggleButton.mood-label">
        <Setter Property="Padding" Value="{StaticResource Metrics.Spacing.Thickness.Wide.Xxs}" />
        <Setter Property="CornerRadius" Value="{StaticResource Metrics.Radius.Xs}" />
        <Setter Property="FontSize" Value="{StaticResource Metrics.FontSize.Xs}" />

        <Style
            Selector="^ /template/ ContentPresenter,
                      ^:pointerover /template/ ContentPresenter,
                      ^:pressed /template/ ContentPresenter">
            
            <Setter Property="Background" Value="{DynamicResource Sem.Surface.Elevated}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sem.Border.Input}" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground}" />
            
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />

            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
            
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>

        <Style Selector="^:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sem.Surface.Brand}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sem.Brand}" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Brand.Strong}" />
        </Style>
        
        <Setter Property="RenderTransform">
            <TranslateTransform />
        </Setter>
        
        <Style.Animations>
            <Animation Duration="0:0:0.45" Easing="CubicEaseOut" FillMode="Forward">
                
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="-20" />
                </KeyFrame>
                
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
                
            </Animation>
        </Style.Animations>

    </Style>
    
</Styles>