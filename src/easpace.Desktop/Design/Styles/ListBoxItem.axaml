<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:easpace.Desktop.Design.Controls">

    <!-- Journal entries styling -->
    <Style Selector="ListBox.journal.list ListBoxItem">

        <Setter Property="Padding" Value="{StaticResource Metrics.Spacing.Thickness.Horizontal.Xxs}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="^ TextBlock.journal-list-item">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground}" />
        </Style>

        <Style Selector="^ TextBlock.journal-sub-list-item">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground.Subtle}" />
        </Style>

        <Style Selector="^ TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="^:selected TextBlock">
            <Setter Property="FontWeight" Value="{StaticResource Metrics.FontWeight.Medium}" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Brand}" />
        </Style>

        <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Brand.Strong}" />
        </Style>

    </Style>

    <!-- Navigation items styling -->
    <Style Selector="ListBox.nav.list ListBoxItem">

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground.Subtle}" />
        <Setter Property="Padding" Value="{StaticResource Metrics.Spacing.Thickness.Wide.Sm}" />
        <Setter Property="CornerRadius" Value="{StaticResource Metrics.Radius.Sm}" />
        <Setter Property="Cursor" Value="Hand" />

        <Style Selector="^ controls|NavigationListItem TextBlock#PART_Text">
            <Setter Property="FontSize" Value="{StaticResource Metrics.FontSize.Xs}" />
            <Setter Property="FontWeight" Value="{StaticResource Metrics.FontWeight.Regular}" />
        </Style>

        <Style Selector="^ controls|NavigationListItem PathIcon#PART_Icon">
            <Setter Property="Width" Value="{StaticResource Metrics.Icon.Size.Xs}" />
            <Setter Property="Height" Value="{StaticResource Metrics.Icon.Size.Xs}" />
        </Style>

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground.Subtle}" />
        </Style>

        <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sem.Gradient.Brand}" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.On.Brand}" />
        </Style>

        <Style Selector="^:selected controls|NavigationListItem TextBlock#PART_Text">
            <Setter Property="FontWeight" Value="{StaticResource Metrics.FontWeight.Medium}" />
        </Style>

        <Style Selector="^:selected controls|NavigationListItem /template/ PathIcon#PART_Icon">
            <Setter Property="Data"
                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedIcon}" />
        </Style>

    </Style>

    <!-- Activity items styling -->
    <Style Selector="ListBox.activity.list ListBoxItem">

        <Setter Property="Background" Value="{DynamicResource Sem.Surface.Elevated}" />
        <Setter Property="CornerRadius" Value="{StaticResource Metrics.Radius.Xs}" />
        <Setter Property="Padding" Value="{StaticResource Metrics.Spacing.Thickness.Wide.Xs}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metrics.Border.Thickness}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sem.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground}" />
        <Setter Property="Cursor" Value="Hand" />

        <Style Selector="^ controls|ActivityListItem PathIcon#PART_Icon">
            <Setter Property="Width" Value="{StaticResource Metrics.Icon.Size.Sm}" />
            <Setter Property="Height" Value="{StaticResource Metrics.Icon.Size.Sm}" />
        </Style>

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sem.Surface.Elevated}" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground}" />
        </Style>

        <Style Selector="^:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sem.Surface.Brand}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sem.Border.Brand}" />
        </Style>

        <Style Selector="^:selected controls|ActivityListItem /template/ PathIcon#PART_Icon">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Brand.Strong}" />
            <Setter Property="Data"
                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedIcon}" />
        </Style>

        <Style Selector="^:selected controls|ActivityListItem TextBlock#PART_Title, 
                         ^:selected controls|ActivityListItem TextBlock#PART_Value,
                         ^:selected controls|ActivityListItem TextBlock#PART_Unit">
            <Setter Property="FontWeight" Value="{StaticResource Metrics.FontWeight.Medium}" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Brand.Strong}" />
        </Style>

    </Style>

    <!-- Segmented styling -->
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="Padding" Value="{StaticResource Metrics.Spacing.Thickness.Wide.3Xs}" />
        <Setter Property="CornerRadius" Value="{StaticResource Metrics.Radius.Xs}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{StaticResource Metrics.FontSize.Xs}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sem.Surface.Brand}" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground}" />
        </Style>

        <Style Selector="^:selected /template/ ContentPresenter, ^:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sem.Brand}" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.On.Brand}" />
        </Style>

    </Style>

    <!-- Toolbar styling -->
    <Style Selector="ListBox.toolbar ListBoxItem">
        <Setter Property="Padding" Value="{StaticResource Metrics.Spacing.Thickness.Xxs}" />
        <Setter Property="Background" Value="Transparent" />

        <Style Selector="^ controls|IconListItem">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground.Muted}" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Cursor" Value="Hand" />

            <Style Selector="^ /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style Selector="^ controls|IconListItem">
                <Setter Property="Foreground" Value="{DynamicResource Sem.Brand}" />
            </Style>
        </Style>

        <Style Selector="^:selected">
            <Style Selector="^ /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <Style Selector="^ controls|IconListItem">
                <Setter Property="Foreground" Value="{DynamicResource Sem.Brand.Strong}" />
            </Style>

            <Style Selector="^ controls|IconListItem /template/ PathIcon#PART_Icon">
                <Setter Property="Data"
                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedIcon}" />
            </Style>

        </Style>

    </Style>

</Styles>