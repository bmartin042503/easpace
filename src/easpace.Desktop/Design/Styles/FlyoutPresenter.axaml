<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="using:easpace.Desktop.Design">
    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource Sem.Surface}"
                design:PreviewScheme.Variant="HavenBlue.Light">
            <FlyoutPresenter>
                <TextBlock Text="Flyout Content" />
            </FlyoutPresenter>
        </Border>
    </Design.PreviewWith>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource Sem.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sem.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metrics.Border.Thickness}" />
        <Setter Property="Margin" Value="{StaticResource Metrics.Spacing.Thickness.Xs}" />
    </Style>
    
</Styles>
