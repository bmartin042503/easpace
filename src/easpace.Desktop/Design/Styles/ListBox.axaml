<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:easpace.Desktop.Design.Controls">
    
    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource Haven.Sem.Canvas}"
                Width="400" Height="400">
            
            <StackPanel Orientation="Vertical" Spacing="20">
                
                <!-- Segmented -->
                <ListBox Classes="segmented">
                
                    <ListBoxItem>Item 1</ListBoxItem>
                    <ListBoxItem>Item 2</ListBoxItem>
                    <ListBoxItem>Item 3</ListBoxItem>
                
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xxs}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                
                </ListBox>
                
                <!-- Toolbar -->
                <ListBox Classes="toolbar"
                         SelectedIndex="0">
                
                    <ListBoxItem>
                        <controls:IconListItem
                            Icon="{StaticResource PhosphorIcons.Target}"
                            SelectedIcon="{StaticResource PhosphorIcons.Target.Fill}"
                            Width="{StaticResource Metrics.Icon.Size.Sm}"
                            Height="{StaticResource Metrics.Icon.Size.Sm}" />
                    </ListBoxItem>
                    
                    <ListBoxItem>
                        <controls:IconListItem
                            Icon="{StaticResource PhosphorIcons.Archive}"
                            SelectedIcon="{StaticResource PhosphorIcons.Archive.Fill}"
                            Width="{StaticResource Metrics.Icon.Size.Sm}"
                            Height="{StaticResource Metrics.Icon.Size.Sm}" />
                    </ListBoxItem>
                
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Metrics.Spacing.Xs}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                
                </ListBox>
                
            </StackPanel>
            
        </Border>
    </Design.PreviewWith>

    <Style Selector="ListBox">
        <Setter Property="SelectionMode" Value="AlwaysSelected,Single" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.segmented">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource Sem.Surface.Elevated}" />
        <Setter Property="Padding" Value="{StaticResource Metrics.Spacing.Thickness.Xxs}" />
        <Setter Property="CornerRadius" Value="{StaticResource Metrics.Radius.Sm}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metrics.Border.Thickness}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Haven.Sem.Border}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

</Styles>