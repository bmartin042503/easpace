<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:easpace.Desktop.Features.Activities.Controls">

    <Style Selector="controls|RoutineMonthItem">

        <Setter Property="ItemSpacing" Value="{StaticResource Metrics.Spacing.Sm}"/>
        <Setter Property="TitleSpacing" Value="{StaticResource Metrics.Spacing.Sm}"/>
        <Setter Property="ItemCornerRadius" Value="{StaticResource Metrics.Radius.Xs}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Metrics.Border.Thickness.Double}"/>
        <Setter Property="TitleFontSize" Value="{StaticResource Metrics.FontSize.Lg}"/>
        <Setter Property="DayFontSize" Value="{StaticResource Metrics.FontSize.Sm}"/>
        <Setter Property="TitleForeground" Value="{DynamicResource Sem.Foreground}"/>
        
        <Setter Property="DummyBackground" Value="Transparent"/>
        <Setter Property="DummyBorderBrush" Value="{DynamicResource Sem.Border}"/>

        <Setter Property="NoneBackground" Value="{DynamicResource Sem.Surface.Elevated}"/>
        <Setter Property="NoneBorderBrush" Value="{DynamicResource Sem.Border}"/>
        <Setter Property="NoneTextForeground" Value="{DynamicResource Sem.Foreground}"/>

        <Setter Property="CompletedBackground" Value="{DynamicResource Sem.Surface.Success}"/>
        <Setter Property="CompletedBorderBrush" Value="{DynamicResource Sem.Success.Strong}"/>
        <Setter Property="CompletedTextForeground" Value="{DynamicResource Sem.Success.Strong}"/>

        <Setter Property="NotCompletedBackground" Value="{DynamicResource Sem.Surface.Danger}"/>
        <Setter Property="NotCompletedBorderBrush" Value="{DynamicResource Sem.Danger.Strong}"/>
        <Setter Property="NotCompletedTextForeground" Value="{DynamicResource Sem.Danger.Strong}"/>
        
        <Setter Property="TodayBorderBrush" Value="{DynamicResource Sem.Brand}"/>
        
    </Style>
</Styles>
