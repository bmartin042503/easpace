<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:easpace.Desktop.Behaviors"
                    xmlns:design="clr-namespace:easpace.Desktop.Design">

    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource Sem.Surface}"
                design:PreviewScheme.Variant="HavenBlue.Light">
            <StackPanel Spacing="20">
                <Slider Minimum="0" Maximum="1" MinWidth="200" MaxWidth="400" Value="0.5" />
                <Slider Classes="filled" Minimum="0" Maximum="1" MinWidth="200" MaxWidth="400" Value="0.5" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">

        <Setter Property="behaviors:SliderBehavior.JumpToClick" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Sem.Brand}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Brand}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metrics.Border.Thickness}" />

        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid x:Name="SliderContainer"
                              Margin="{TemplateBinding Padding}"
                              Background="Transparent">

                            <Grid x:Name="HorizontalTemplate" MinHeight="6"
                                  ColumnDefinitions="Auto,Auto,*" RowDefinitions="6,Auto,6">

                                <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="3"
                                        Classes="elevated card" VerticalAlignment="Center"
                                        Height="16" />

                                <Track x:Name="PART_Track"
                                       Grid.Column="0"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}"
                                       IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                       Orientation="Horizontal">

                                    <!-- Selection fill, shown with the "filled" class. It is not named PART_DecreaseButton
                                         and not hit-testable, so clicks still reach SliderBehavior's jump-to-click. -->
                                    <Track.DecreaseButton>
                                        <Button Name="SelectionFill" IsVisible="False"
                                                IsHitTestVisible="False" Focusable="False" ClipToBounds="False"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate>
                                                    <!-- extends under the thumb (half its width) so the fill meets the round thumb without a gap;
                                                         needs ClipToBounds=False on the button, which the Fluent theme turns on -->
                                                    <Border Height="16" Margin="0,0,-12,0" CornerRadius="8"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource Sem.Progress}" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Track.DecreaseButton>

                                    <Thumb Name="thumb"
                                           ZIndex="1"
                                           Width="24"
                                           Height="24"
                                           Margin="0"
                                           Padding="0"
                                           Background="{DynamicResource Sem.Gradient.Brand}"
                                           BorderBrush="{DynamicResource Sem.Brand.Strong}"
                                           BorderThickness="0.75"
                                           DataContext="{TemplateBinding Value}" />

                                </Track>

                            </Grid>

                        </Grid>

                    </Border>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <Style Selector="^.filled /template/ Button#SelectionFill">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:pointerover /template/ Thumb#thumb, ^:pressed /template/ Thumb#thumb">
            <Setter Property="Background" Value="{DynamicResource Sem.Gradient.Brand}" />
        </Style>

        <Style Selector="^ /template/ Thumb#thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20" />
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^ /template/ Thumb#thumb:pointerover, ^ /template/ Thumb#thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource Sem.Gradient.Brand}" />
        </Style>

    </ControlTheme>

</ResourceDictionary>