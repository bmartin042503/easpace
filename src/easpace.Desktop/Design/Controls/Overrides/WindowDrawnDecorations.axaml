<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">

    <ControlTheme x:Key="ControlTheme.CaptionButton" TargetType="Button">

        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="Transparent"
                                  Content="{TemplateBinding Content}"
                                  Padding="{StaticResource Metrics.Spacing.Thickness.Wide.Xs}" />
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Sem.On.Brand}" />
        </Style>
        
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sem.Brand}" />
        </Style>
        
        <Style Selector="^#PART_CloseButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Sem.On.Danger}" />
        </Style>
        
        <Style Selector="^#PART_CloseButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sem.Danger}" />
        </Style>

    </ControlTheme>

    <ControlTheme x:Key="{x:Type WindowDrawnDecorations}" TargetType="WindowDrawnDecorations">
        <Setter Property="Template">
            <WindowDrawnDecorationsTemplate>
                <WindowDrawnDecorationsContent>

                    <WindowDrawnDecorationsContent.Overlay>
                        <Panel x:Name="PART_OverlayWrapper" VerticalAlignment="Top">

                            <StackPanel x:Name="PART_OverlayPanel" Orientation="Horizontal" HorizontalAlignment="Right">

                                <!-- Minimize button -->
                                <Button x:Name="PART_MinimizeButton"
                                        Theme="{StaticResource ControlTheme.CaptionButton}"
                                        WindowDecorationProperties.ElementRole="MinimizeButton">
                                    <PathIcon Data="{StaticResource PhosphorIcons.Minus}"
                                              Width="{StaticResource Metrics.Icon.Size.Xxs}"
                                              Height="{StaticResource Metrics.Icon.Size.Xxs}"
                                              IsHitTestVisible="False" />
                                </Button>

                                <!-- Maximize/Minimize button -->
                                <Button x:Name="PART_MaximizeButton"
                                        Theme="{StaticResource ControlTheme.CaptionButton}"
                                        WindowDecorationProperties.ElementRole="MaximizeButton">
                                    <PathIcon Name="RestoreButtonPathIcon"
                                              Data="{StaticResource PhosphorIcons.Square}"
                                              Width="{StaticResource Metrics.Icon.Size.Xxs}"
                                              Height="{StaticResource Metrics.Icon.Size.Xxs}"
                                              IsHitTestVisible="False" />
                                </Button>

                                <!-- Close button -->
                                <Button x:Name="PART_CloseButton"
                                        Theme="{StaticResource ControlTheme.CaptionButton}"
                                        WindowDecorationProperties.ElementRole="CloseButton">
                                    
                                    <PathIcon Data="{StaticResource PhosphorIcons.X}"
                                              Width="{StaticResource Metrics.Icon.Size.Xxs}"
                                              Height="{StaticResource Metrics.Icon.Size.Xxs}"
                                              IsHitTestVisible="False" />
                                    
                                </Button>

                            </StackPanel>
                        </Panel>
                    </WindowDrawnDecorationsContent.Overlay>

                </WindowDrawnDecorationsContent>
            </WindowDrawnDecorationsTemplate>
        </Setter>

        <Style Selector="^:maximized /template/ PathIcon#RestoreButtonPathIcon">
            <Setter Property="Data"
                    Value="{StaticResource PhosphorIcons.CopySimple}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>