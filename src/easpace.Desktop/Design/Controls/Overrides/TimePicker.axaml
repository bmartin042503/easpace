<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="TimePicker.Width">120</x:Double>
    <x:Double x:Key="TimePicker.ItemMinWidth">48</x:Double>
    <x:Double x:Key="TimePicker.ItemHeight">40</x:Double>
    <x:Double x:Key="TimePicker.SpacerWidth">1</x:Double>
    <x:Double x:Key="TimePicker.PresenterMaxWidth">200</x:Double>
    <x:Double x:Key="TimePicker.PresenterMaxHeight">260</x:Double>
    <x:Double x:Key="TimePicker.ActionHeight">40</x:Double>

    <ControlTheme x:Key="TimePicker.FlyoutButton" TargetType="Button">

        <Setter Property="ClickMode" Value="Release" />
        <Setter Property="MinHeight" Value="{StaticResource Metrics.Input.Height}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Sem.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sem.Border.Input}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metrics.Border.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Metrics.Radius.Xs}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Sem.Surface.Brand}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sem.Border.Brand}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Sem.Surface.Brand}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sem.Brand}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Sem.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sem.Border.Input}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground.Muted}" />
        </Style>

    </ControlTheme>

    <ControlTheme x:Key="TimePicker.Item" TargetType="ListBoxItem">

        <Setter Property="Width" Value="{StaticResource TimePicker.ItemMinWidth}" />
        <Setter Property="Height" Value="{StaticResource TimePicker.ItemHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource Metrics.Radius.Xs}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Metrics.FontSize.Sm}" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource Sem.Brand}" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.On.Brand}" />
            <Setter Property="FontWeight" Value="{StaticResource Metrics.FontWeight.Medium}" />
        </Style>

        <Style Selector="^:pointerover:not(:selected) /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Sem.Surface.Brand}" />
        </Style>

        <Style Selector="^:pointerover:not(:selected)">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Brand.Strong}" />
        </Style>

        <Style Selector="^:pressed:not(:selected) /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Sem.Accent.Muted.Hover}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground.Muted}" />
        </Style>

    </ControlTheme>

    <ControlTheme x:Key="TimePicker.HiddenSpinnerButton" TargetType="RepeatButton">

        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel IsVisible="False" />
            </ControlTemplate>
        </Setter>

    </ControlTheme>

    <ControlTheme x:Key="TimePicker.ActionButton" TargetType="Button">

        <Setter Property="ClickMode" Value="Release" />
        <Setter Property="Height" Value="{StaticResource TimePicker.ActionHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground.Subtle}" />
        <Setter Property="Background" Value="{DynamicResource Sem.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sem.Border.Input}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Metrics.Radius.Xs}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Sem.Surface.Brand}" />
        </Style>
        
        <Style Selector="^.danger:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Sem.Surface.Danger}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground.Muted}" />
        </Style>

    </ControlTheme>

    <ControlTheme x:Key="{x:Type TimePicker}" TargetType="TimePicker">

        <Setter Property="Width" Value="{StaticResource TimePicker.Width}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{StaticResource Metrics.Input.Height}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Sem.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sem.Border.Input}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metrics.Border.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Metrics.Radius.Xs}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />

        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Grid Name="LayoutRoot"
                          Height="{StaticResource Metrics.Input.Height}"
                          VerticalAlignment="Top">

                        <Button Name="PART_FlyoutButton"
                                Theme="{StaticResource TimePicker.FlyoutButton}"
                                Foreground="{TemplateBinding Foreground}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsEnabled="{TemplateBinding IsEnabled}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">

                            <Grid Name="PART_FlyoutButtonContentGrid"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">

                                <Border Name="PART_FirstPickerHost"
                                        Grid.Column="0"
                                        MinWidth="{StaticResource TimePicker.ItemMinWidth}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <TextBlock Name="PART_HourTextBlock"
                                               Text="{StaticResource StringTimePickerHourText}"
                                               FontSize="{StaticResource Metrics.FontSize.Xs}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Padding="8,0" />
                                </Border>

                                <Rectangle Name="PART_FirstColumnDivider"
                                           Grid.Column="1"
                                           Fill="{DynamicResource Sem.Border.Input}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch"
                                           Width="{StaticResource TimePicker.SpacerWidth}" />

                                <Border Name="PART_SecondPickerHost"
                                        Grid.Column="2"
                                        MinWidth="{StaticResource TimePicker.ItemMinWidth}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <TextBlock Name="PART_MinuteTextBlock"
                                               Text="{StaticResource StringTimePickerMinuteText}"
                                               FontSize="{StaticResource Metrics.FontSize.Xs}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Padding="8,0" />
                                </Border>

                                <Rectangle Name="PART_SecondColumnDivider"
                                           Grid.Column="3"
                                           Fill="{DynamicResource Sem.Border.Input}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch"
                                           Width="{StaticResource TimePicker.SpacerWidth}" />

                                <Border Name="PART_ThirdPickerHost"
                                        Grid.Column="4"
                                        MinWidth="{StaticResource TimePicker.ItemMinWidth}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <TextBlock Name="PART_SecondTextBlock"
                                               Text="{StaticResource StringTimePickerSecondText}"
                                               FontSize="{StaticResource Metrics.FontSize.Xs}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Padding="8,0" />
                                </Border>

                                <Rectangle Name="PART_ThirdColumnDivider"
                                           Grid.Column="5"
                                           Fill="{DynamicResource Sem.Border.Input}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Stretch"
                                           Width="{StaticResource TimePicker.SpacerWidth}" />

                                <Border Name="PART_FourthPickerHost"
                                        Grid.Column="6"
                                        MinWidth="{StaticResource TimePicker.ItemMinWidth}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <TextBlock Name="PART_PeriodTextBlock"
                                               FontSize="{StaticResource Metrics.FontSize.Xs}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Padding="8,0" />
                                </Border>

                            </Grid>

                        </Button>

                        <Popup Name="PART_Popup"
                               WindowManagerAddShadowHint="False"
                               IsLightDismissEnabled="True"
                               PlacementTarget="{TemplateBinding}"
                               Placement="Bottom">
                            <TimePickerPresenter Name="PART_PickerPresenter"
                                                 Margin="0,4,0,0"
                                                 MaxWidth="{StaticResource TimePicker.PresenterMaxWidth}"
                                                 MaxHeight="{StaticResource TimePicker.PresenterMaxHeight}"
                                                 HorizontalAlignment="Center" />
                        </Popup>

                    </Grid>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled /template/ Rectangle">
            <Setter Property="Fill" Value="{DynamicResource Sem.Border.Input}" />
        </Style>

        <Style Selector="^:hasnotime /template/ Button#PART_FlyoutButton TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground.Subtle}" />
        </Style>

        <Style Selector="^:error /template/ Button#PART_FlyoutButton">
            <Setter Property="BorderBrush" Value="{DynamicResource Sem.Danger}" />
            <Setter Property="BorderThickness" Value="{StaticResource Metrics.Border.Thickness.Medium}" />
        </Style>

    </ControlTheme>

    <ControlTheme x:Key="{x:Type TimePickerPresenter}" TargetType="TimePickerPresenter">

        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MaxWidth" Value="{StaticResource TimePicker.PresenterMaxWidth}" />
        <Setter Property="MaxHeight" Value="{StaticResource TimePicker.PresenterMaxHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Sem.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Sem.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sem.Border.Input}" />
        <Setter Property="BorderThickness" Value="{StaticResource Metrics.Border.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Metrics.Radius.Md}" />
        <Setter Property="Padding" Value="{StaticResource Metrics.Spacing.Thickness.Xs}" />
        <Setter Property="HorizontalAlignment" Value="Center" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Background"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        MaxWidth="{StaticResource TimePicker.PresenterMaxWidth}"
                        MaxHeight="{StaticResource TimePicker.PresenterMaxHeight}"
                        ClipToBounds="True">

                    <Grid Name="ContentPanel"
                          RowDefinitions="*,Auto"
                          RowSpacing="{StaticResource Metrics.Spacing.Xs}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">

                        <Grid Name="PART_PickerContainer"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">

                            <Grid.Styles>
                                <Style Selector="DateTimePickerPanel > ListBoxItem">
                                    <Setter Property="Theme" Value="{StaticResource TimePicker.Item}" />
                                </Style>
                            </Grid.Styles>

                            <Panel Name="PART_HourHost"
                                   Grid.Column="0"
                                   MinWidth="{StaticResource TimePicker.ItemMinWidth}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                    <DateTimePickerPanel Name="PART_HourSelector"
                                                         PanelType="Hour"
                                                         ShouldLoop="True"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         ItemHeight="{StaticResource TimePicker.ItemHeight}" />
                                </ScrollViewer>
                                <RepeatButton Name="PART_HourUpButton"
                                              Theme="{StaticResource TimePicker.HiddenSpinnerButton}"
                                              IsVisible="False"
                                              IsHitTestVisible="False" />
                                <RepeatButton Name="PART_HourDownButton"
                                              Theme="{StaticResource TimePicker.HiddenSpinnerButton}"
                                              IsVisible="False"
                                              IsHitTestVisible="False" />
                            </Panel>

                            <Panel Name="PART_MinuteHost" Grid.Column="2"
                                   MinWidth="{StaticResource TimePicker.ItemMinWidth}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                    <DateTimePickerPanel Name="PART_MinuteSelector"
                                                         PanelType="Minute"
                                                         ShouldLoop="True"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         ItemHeight="{StaticResource TimePicker.ItemHeight}" />
                                </ScrollViewer>
                                <RepeatButton Name="PART_MinuteUpButton"
                                              Theme="{StaticResource TimePicker.HiddenSpinnerButton}"
                                              IsVisible="False"
                                              IsHitTestVisible="False" />
                                <RepeatButton Name="PART_MinuteDownButton"
                                              Theme="{StaticResource TimePicker.HiddenSpinnerButton}"
                                              IsVisible="False"
                                              IsHitTestVisible="False" />
                            </Panel>

                            <Panel Name="PART_SecondHost" Grid.Column="4"
                                   MinWidth="{StaticResource TimePicker.ItemMinWidth}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                    <DateTimePickerPanel Name="PART_SecondSelector"
                                                         PanelType="Second"
                                                         ShouldLoop="True"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         ItemHeight="{StaticResource TimePicker.ItemHeight}" />
                                </ScrollViewer>
                                <RepeatButton Name="PART_SecondUpButton"
                                              Theme="{StaticResource TimePicker.HiddenSpinnerButton}"
                                              IsVisible="False"
                                              IsHitTestVisible="False" />
                                <RepeatButton Name="PART_SecondDownButton"
                                              Theme="{StaticResource TimePicker.HiddenSpinnerButton}"
                                              IsVisible="False"
                                              IsHitTestVisible="False" />
                            </Panel>

                            <Panel Name="PART_PeriodHost" Grid.Column="6"
                                   MinWidth="{StaticResource TimePicker.ItemMinWidth}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                    <DateTimePickerPanel Name="PART_PeriodSelector"
                                                         PanelType="TimePeriod"
                                                         ShouldLoop="False"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"
                                                         ItemHeight="{StaticResource TimePicker.ItemHeight}" />
                                </ScrollViewer>
                            </Panel>

                            <Rectangle Name="PART_FirstSpacer" Grid.Column="1"
                                       Fill="{DynamicResource Sem.Border.Input}"
                                       HorizontalAlignment="Center"
                                       Width="{StaticResource TimePicker.SpacerWidth}" />

                            <Rectangle Name="PART_SecondSpacer" Grid.Column="3"
                                       Fill="{DynamicResource Sem.Border.Input}"
                                       HorizontalAlignment="Center"
                                       Width="{StaticResource TimePicker.SpacerWidth}" />

                            <Rectangle Name="PART_ThirdSpacer" Grid.Column="5"
                                       Fill="{DynamicResource Sem.Border.Input}"
                                       HorizontalAlignment="Center"
                                       Width="{StaticResource TimePicker.SpacerWidth}" />

                        </Grid>

                        <Grid Name="AcceptDismissGrid" Grid.Row="1"
                              ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Metrics.Spacing.Xs}">

                            <Button Name="PART_AcceptButton"
                                    Grid.Column="0"
                                    Theme="{StaticResource TimePicker.ActionButton}"
                                    Foreground="{DynamicResource Sem.Brand.Strong}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">

                                <Grid Background="Transparent">
                                    <PathIcon
                                        Width="{StaticResource Metrics.Icon.Size.Xs}"
                                        Height="{StaticResource Metrics.Icon.Size.Xs}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Foreground="{Binding $parent[Button].Foreground}"
                                        Data="{StaticResource PhosphorIcons.Check.Bold}" />
                                </Grid>

                            </Button>

                            <Button Name="PART_DismissButton"
                                    Grid.Column="1" Classes="danger"
                                    Theme="{StaticResource TimePicker.ActionButton}"
                                    Foreground="{DynamicResource Sem.Danger.Strong}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">

                                <Grid Background="Transparent">
                                    <PathIcon
                                        Width="{StaticResource Metrics.Icon.Size.Xs}"
                                        Height="{StaticResource Metrics.Icon.Size.Xs}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Foreground="{Binding $parent[Button].Foreground}"
                                        Data="{StaticResource PhosphorIcons.X.Bold}" />
                                </Grid>

                            </Button>

                        </Grid>

                    </Grid>

                </Border>
            </ControlTemplate>
        </Setter>

    </ControlTheme>

</ResourceDictionary>